    { "id": "db", "type": "database", "label": "DynamoDB" }
  ],
  "segments": [
    { "from": 145, "to": 280, "label": "Default acceptance path · WAL recording runs asynchronously after ACK" },
    { "from": 310, "to": 415, "label": "After WAL recording succeeds · separate loop for valid entries" },
    { "from": 445, "to": 550, "label": "Alternative · database write errors or unprocessed items" }
