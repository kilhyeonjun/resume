---
import Layout from '../../layouts/Layout.astro';
import GitHubIcon from '../icons/GitHubIcon.astro';
import ExternalLinkIcon from '../icons/ExternalLinkIcon.astro';
import type { PortfolioProject, PortfolioLabels } from '../../types/portfolio';
import { getLocalePrefix, withBasePath } from '../../utils/paths';

interface Props {
  lang: 'ko' | 'en';
  projects: PortfolioProject[];
  labels: PortfolioLabels;
}

const { lang, projects: rawProjects, labels } = Astro.props;
const localePrefix = getLocalePrefix(lang);
const projects = [...rawProjects].sort((a, b) =>
  (a.printOrder ?? Number.MAX_SAFE_INTEGER) - (b.printOrder ?? Number.MAX_SAFE_INTEGER)
  || new Date(b.period.start).getTime() - new Date(a.period.start).getTime()
);
const featuredProjects = projects.filter((project) => project.featured).slice(0, 3);
const archiveProjects = projects.filter((project) => !featuredProjects.some((featured) => featured.slug === project.slug));
---

<Layout title={`${labels.portfolio} | Portfolio`} description={lang === 'ko' ? '개인 프로젝트 포트폴리오' : 'Personal Project Portfolio'} lang={lang}>
  <div class="portfolio-index">
    <header class="portfolio-hero">
      <span class="dossier-label">SELECTED ENGINEERING WORK</span>
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white sm:text-4xl md:text-4xl lg:text-5xl">
        {labels.portfolio}
      </h1>
      <p class="mt-4 text-lg text-gray-600 dark:text-gray-300">
        {lang === 'ko' ? '개인 및 팀 프로젝트 모음' : 'Collection of personal and team projects'}
      </p>
      <div class="mt-4 text-sm">
        <a href={`${localePrefix}/portfolio-print`} class="touch-target inline-flex items-center rounded-lg border border-gray-300 px-4 font-semibold text-gray-700 transition-colors hover:bg-gray-100 hover:text-primary-700 dark:border-gray-600 dark:text-gray-200 dark:hover:bg-gray-800 dark:hover:text-primary-300">{lang === 'ko' ? 'PDF 다운로드' : 'Download PDF'}</a>
      </div>
    </header>

    <div class="portfolio-grid">
      {featuredProjects.map((project, index) => {
        const projectName = project.name[lang] || project.name.ko;
        const projectSummary = project.summary[lang] || project.summary.ko;
        const coverImage = typeof project.coverImage === 'string' ? project.coverImage : project.coverImage?.[lang];
        const period = `${project.period.start} — ${project.period.end}`;
        
        return (
          <article class:list={["portfolio-case group", index === 0 && "portfolio-case-featured"]}>
            {/* Cover Image */}
            {coverImage ? (
              <a href={`${localePrefix}/portfolio/${project.slug}`} class="block aspect-video overflow-hidden">
                <img 
                  src={withBasePath(coverImage)}
                  alt={`${projectName} ${labels.portfolio} cover`}
                  width={800}
                  height={450}
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  sizes="(max-width: 640px) 100vw, 50vw"
                  loading={index < 2 ? "eager" : "lazy"}
                />
              </a>
            ) : (
              <a
                href={`${localePrefix}/portfolio/${project.slug}`}
                class="portfolio-cover flex aspect-video items-center justify-center overflow-hidden"
              >
                <span class="px-4 text-center text-lg font-bold text-white/90 drop-shadow-sm">
                  {projectName}
                </span>
              </a>
            )}
            
            <div class="p-5 sm:p-6">
            <div class="mb-3 flex items-center justify-between gap-3">
              <span class={`inline-block rounded-full px-2.5 py-0.5 text-xs font-medium ${project.type === 'team' ? 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300' : 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300'}`}>
                {project.type === 'team' ? labels.team : labels.personal}
              </span>
              <span class="text-xs text-gray-500 dark:text-gray-300">
                {period}
              </span>
            </div>

            <h2 class="mb-2 text-xl font-bold text-gray-900 dark:text-white">
              <a 
                href={`${localePrefix}/portfolio/${project.slug}`}
                class="transition-colors hover:text-primary-600 dark:hover:text-primary-400"
              >
                {projectName}
              </a>
            </h2>

            <p class="mb-5 line-clamp-2 text-sm leading-6 text-gray-600 dark:text-gray-300">
              {projectSummary}
            </p>

            {index === 0 && project.metrics && project.metrics.length > 0 && (
              <div class="portfolio-proof-strip" aria-label={lang === 'ko' ? '대표 성과' : 'Key outcomes'}>
                {project.metrics.slice(0, 2).map((metric) => {
                  const after = typeof metric.after === 'string'
                    ? metric.after
                    : (metric.after[lang] || metric.after.ko);
                  return (
                    <div>
                      <span>{metric.label[lang] || metric.label.ko}</span>
                      <strong>{after}</strong>
                    </div>
                  );
                })}
              </div>
            )}

            {/* Skills */}
            <div class="mb-4 flex flex-wrap gap-1.5">
              {project.skills.slice(0, 4).map((skill: string) => (
                 <span class="tech-badge">
                  {skill}
                </span>
              ))}
              {project.skills.length > 4 && (
                 <span class="rounded-md bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-600 dark:bg-gray-700 dark:text-gray-200">
                  +{project.skills.length - 4}
                </span>
              )}
            </div>

            {/* Links */}
            <div class="flex items-center justify-between">
              <div class="flex gap-3">
                {project.github && (
                  <a 
                    href={project.github} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="text-gray-500 transition-colors hover:text-gray-900 dark:text-gray-300 dark:hover:text-white"
                    aria-label={labels.github}
                  >
                    <GitHubIcon class="h-5 w-5" />
                  </a>
                )}
              </div>
              <a 
                href={`${localePrefix}/portfolio/${project.slug}`}
                class="touch-target inline-flex items-center gap-1 text-sm font-semibold text-primary-600 dark:text-primary-400"
              >
                {labels.viewDetails}
                <ExternalLinkIcon class="h-3.5 w-3.5" />
              </a>
            </div>
            </div>
          </article>
        );
      })}
    </div>

    {archiveProjects.length > 0 && (
      <section class="portfolio-archive" aria-labelledby="archive-title">
        <span class="dossier-label">PROJECT ARCHIVE</span>
        <h2 id="archive-title">{lang === 'ko' ? '프로젝트 아카이브' : 'Project archive'}</h2>
        <div>
          {archiveProjects.map((project) => {
            const projectName = project.name[lang] || project.name.ko;
            const projectSummary = project.summary[lang] || project.summary.ko;
            return (
              <a class="portfolio-archive-row" href={`${localePrefix}/portfolio/${project.slug}`}>
                <span>{project.period.start}</span>
                <strong>{projectName}</strong>
                <span>{projectSummary}</span>
                <span aria-hidden="true">↗</span>
              </a>
            );
          })}
        </div>
      </section>
    )}
  </div>
</Layout>
