---
import Layout from '../../layouts/Layout.astro';
import ExternalLinkIcon from '../icons/ExternalLinkIcon.astro';
import BlogIcon from '../icons/BlogIcon.astro';
import YouTubeIcon from '../icons/YouTubeIcon.astro';
import CheckIcon from '../icons/CheckIcon.astro';
import ArrowLeftIcon from '../icons/ArrowLeftIcon.astro';
import ArrowRightIcon from '../icons/ArrowRightIcon.astro';
import GitHubIcon from '../icons/GitHubIcon.astro';
import type { PortfolioProject, PortfolioLabels, BlogPost } from '../../types/portfolio';
import { getLocalePrefix, withBasePath } from '../../utils/paths';

interface Props {
  lang: 'ko' | 'en';
  project: PortfolioProject;
  index: number;
  total: number;
  allProjects: PortfolioProject[];
  labels: PortfolioLabels;
}

const { lang, project, index, total, allProjects, labels } = Astro.props;
const prevProject = index > 0 ? allProjects[index - 1] : null;
const nextProject = index < total - 1 ? allProjects[index + 1] : null;

const period = `${project.period.start} — ${project.period.end}`;
const localePrefix = getLocalePrefix(lang);

const localize = (value: string | { ko: string; en: string }) => typeof value === 'string' ? value : (value[lang] || value.ko);
const projectName = project.name[lang] || project.name.ko;
const projectSummary = project.summary[lang] || project.summary.ko;
const projectHighlights = project.highlights[lang] || project.highlights.ko;
const teamComposition = project.teamComposition ? (project.teamComposition[lang] || project.teamComposition.ko) : null;
const projectDescription = project.description ? (project.description[lang] || project.description.ko) : null;
const projectFeatures = project.features ? (project.features[lang] || project.features.ko) : null;
const projectLessons = project.lessons ? (project.lessons[lang] || project.lessons.ko) : null;
const projectTechDecisions = project.techDecisions ? (project.techDecisions[lang] || project.techDecisions.ko) : null;
const projectScale = project.scale ? (project.scale[lang] || project.scale.ko) : null;
const projectRole = project.role ? (project.role[lang] || project.role.ko) : null;
const projectGlossary = project.glossary ?? null;
const projectProblemSolving = project.problemSolving ?? null;
const projectScenarioEvidence = project.scenarioEvidence ?? null;
const projectPublicEvidence = project.publicEvidence ?? null;
const projectOperationalLimits = project.operationalLimits ? project.operationalLimits[lang] : null;
const projectCoverImage = project.coverImage ? localize(project.coverImage) : null;
const projectArchitectureDiagram = project.architectureDiagram ? localize(project.architectureDiagram) : null;
const projectSequenceDiagram = project.sequenceDiagram ? localize(project.sequenceDiagram) : null;
const isEvidenceRegister = project.slug === 'ai-coding-harness';
const isDaesinCase = project.slug === 'daesin-logistics-bot';
const evidenceIndex: Array<{ id: string; label: string }> = [];
const addEvidence = (condition: unknown, id: string, label: string) => {
  if (condition) evidenceIndex.push({ id, label });
};
addEvidence((isEvidenceRegister || isDaesinCase) && project.metrics?.length, 'outcomes', lang === 'ko' ? '성과 지표' : 'Outcomes');
addEvidence(isEvidenceRegister && projectArchitectureDiagram, 'boundary', lang === 'ko' ? '프로필 경계' : 'Profile boundary');
addEvidence(isEvidenceRegister && projectSequenceDiagram, 'sequence', lang === 'ko' ? '실행 흐름' : 'Launch flow');
addEvidence(!isEvidenceRegister && !isDaesinCase && project.metrics?.length, 'outcomes', labels.metrics);
addEvidence(projectProblemSolving?.length, 'problems', labels.problemSolving);
addEvidence(!isEvidenceRegister && !isDaesinCase && projectArchitectureDiagram, 'architecture', lang === 'ko' ? '시스템 아키텍처' : 'System architecture');
addEvidence(isDaesinCase && projectArchitectureDiagram, 'architecture', lang === 'ko' ? '운영 경계' : 'Operating boundary');
addEvidence(isDaesinCase && projectOperationalLimits?.length, 'limits', lang === 'ko' ? '운영 한계' : 'Operating limits');
addEvidence(projectPublicEvidence?.length, 'public-evidence', lang === 'ko' ? '공개 근거' : 'Public evidence');
addEvidence(projectDescription && !isDaesinCase, 'description', labels.description);
addEvidence(teamComposition, 'team', labels.teamComposition);
addEvidence(project.collaborationTools?.length, 'collaboration', labels.collaborationTools);
addEvidence(!isDaesinCase && projectHighlights?.length, 'highlights', labels.highlights);
addEvidence(!isDaesinCase && projectTechDecisions?.length, 'decisions', labels.techDecisions);
addEvidence(!projectProblemSolving && projectFeatures?.length, 'features', labels.features);
addEvidence(!isDaesinCase && projectLessons?.length, 'lessons', labels.lessons);
addEvidence(projectGlossary?.length, 'glossary', lang === 'ko' ? '용어 풀이' : 'Glossary');
addEvidence(project.skills?.length, 'stack', labels.skills);
addEvidence(project.blogPosts?.length, 'related-posts', labels.relatedPosts);
addEvidence(!isEvidenceRegister && project.links && Object.keys(project.links).length, 'related-links', labels.relatedLinks);
addEvidence(project.contentImages?.length, 'project-images', labels.projectImages);
---

<Layout title={`${projectName} | Portfolio`} description={projectSummary} lang={lang}>
  <article class:list={['detail-dossier portfolio-detail', isEvidenceRegister && 'case-study-evidence-register', isDaesinCase && 'daesin-case']}>
    <!-- Back to Portfolio -->
    <nav class="mb-8">
      <a 
        href={`${localePrefix}/portfolio`}
        class="touch-target group inline-flex items-center gap-2 text-sm text-gray-600 hover:text-primary-600 dark:text-gray-300 dark:hover:text-primary-400"
      >
        <ArrowLeftIcon class="h-4 w-4 transition-transform group-hover:-translate-x-0.5" />
        {labels.backToPortfolio}
      </a>
    </nav>

    <!-- Project Header -->
    <header class="mb-10">
      <div class="project-heading mb-6 flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
        <div>
          <div class="mb-2 flex items-center gap-2">
            <span class={`inline-block rounded-full px-3 py-1 text-xs font-medium ${project.type === 'team' ? 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300' : 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300'}`}>
              {project.type === 'team' ? labels.team : labels.personal}
            </span>
            {projectScale && (
              <span class="inline-block rounded-full border border-emerald-300 bg-emerald-50 px-3 py-1 text-xs font-medium text-emerald-700 dark:border-emerald-700 dark:bg-emerald-900/20 dark:text-emerald-300">
                {projectScale}
              </span>
            )}
          </div>
          <h1 class="text-3xl font-bold text-gray-900 dark:text-white md:text-4xl">
            {projectName}
          </h1>
          {projectRole && (
            <p class="project-role mt-3 text-sm font-semibold text-primary-700 dark:text-primary-300">
              {projectRole}
            </p>
          )}
        </div>
        <p class="text-sm font-medium text-gray-500 dark:text-gray-300 md:text-base">
          {period}
        </p>
      </div>
      <p class="project-summary mt-4 text-lg text-gray-600 dark:text-gray-300">{projectSummary}</p>
      
      {/* GitHub & Links */}
      <div class="project-proof-links mt-6 flex flex-wrap gap-3">
        {project.github && !isDaesinCase && (
          <a 
            href={project.github} 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center gap-2 rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-gray-700 dark:bg-gray-100 dark:text-gray-900 dark:hover:bg-gray-300"
          >
            <GitHubIcon class="h-4 w-4" />
            {labels.github}
          </a>
        )}
        {(isEvidenceRegister || isDaesinCase) && project.links && Object.entries(project.links).map(([key, url]) => (
          typeof url === 'string' && (
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-primary-700 transition-colors hover:border-primary-400 hover:bg-primary-50 dark:border-gray-600 dark:bg-gray-900 dark:text-primary-300 dark:hover:border-primary-500"
            >
              {key}
              <ExternalLinkIcon class="h-4 w-4" />
            </a>
          )
        ))}
      </div>
      <nav class="evidence-index" aria-label={lang === 'ko' ? '프로젝트 근거 목차' : 'Project evidence index'}>
        {evidenceIndex.map((item, itemIndex) => (
          <a href={`#${item.id}`}><span>{String(itemIndex + 1).padStart(2, '0')}</span>{item.label}</a>
        ))}
      </nav>
    </header>

    {(isEvidenceRegister || isDaesinCase) && project.metrics && project.metrics.length > 0 && (
      <section id="outcomes" class="mb-10 case-outcomes" aria-labelledby="outcomes-title">
        <h2 id="outcomes-title" class="section-title mb-6">{lang === 'ko' ? '검증된 결과' : 'Verified outcomes'}</h2>
        <div class="outcome-register">
          {project.metrics.map((metric) => (
            <article class="outcome-register-entry">
              <p class="outcome-register-label">{metric.label[lang]}</p>
              <h3>{localize(metric.after)}</h3>
              <p class="outcome-register-impact">{localize(metric.improvement)}</p>
              <p class="outcome-register-before"><strong>{lang === 'ko' ? '이전' : 'Before'}:</strong> {localize(metric.before)}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    {isEvidenceRegister && projectArchitectureDiagram && (
      <section id="boundary" class="mb-10 case-boundary">
        <h2 class="section-title mb-3">{lang === 'ko' ? '프로필 경계와 실행 검증' : 'Profile boundaries and launch verification'}</h2>
        <p class="case-diagram-caption mb-6 text-gray-600 dark:text-gray-300">
          {lang === 'ko'
            ? '런처가 작업 경로를 정규화한 뒤 프로필 레지스트리에서 가장 긴 일치 경계를 고릅니다. 경계 없음·동률·심볼릭 링크 이탈은 시작 전에 중단합니다.'
            : 'The launcher canonicalizes the workspace, scans the profile registry, and selects the longest matching boundary. No match, a tie, or a symlink escape aborts before launch.'}
        </p>
        <p class="mb-2 text-xs font-medium text-gray-500 dark:text-gray-400 lg:hidden">
          {lang === 'ko' ? '← 좌우로 스크롤해 전체 흐름 보기 →' : '← Scroll horizontally to view the full flow →'}
        </p>
        <div class="overflow-x-auto rounded-xl border border-gray-200 bg-white dark:border-gray-700">
          <img
            src={withBasePath(projectArchitectureDiagram)}
            alt={lang === 'ko' ? '사용자 요청의 경로를 정규화하고 프로필 레지스트리에서 최장 일치 소유자를 선택한 뒤 소유 런타임과 실행 검증으로 연결하며 경계 없음, 동률, 심볼릭 링크 이탈, 검증 실패를 시작 전에 중단하는 아키텍처' : 'Architecture that canonicalizes the requested workspace, selects the longest matching owner from the profile registry, connects its runtime to launch verification, and aborts before launch on no match, tie, symlink escape, or verification failure'}
            class="min-w-[920px] w-full lg:min-w-0"
            loading="eager"
          />
        </div>
      </section>
    )}

    {isEvidenceRegister && projectSequenceDiagram && (
      <section id="sequence" class="mb-10 case-sequence">
        <h2 class="section-title mb-3">{lang === 'ko' ? '실행과 실패 차단 흐름' : 'Launch and failure-blocking flow'}</h2>
        <p class="case-diagram-caption mb-6 text-gray-600 dark:text-gray-300">
          {lang === 'ko'
            ? '경계 판정, fingerprint 기반 재생성, 설정·원문 검증의 각 실패 경로는 AI CLI가 시작되기 전에 종료됩니다.'
            : 'Boundary resolution, fingerprint-based regeneration, and configuration/source verification all terminate before the AI CLI starts when a gate fails.'}
        </p>
        <p class="mb-2 text-xs font-medium text-gray-500 dark:text-gray-400 lg:hidden">
          {lang === 'ko' ? '← 좌우로 스크롤해 전체 흐름 보기 →' : '← Scroll horizontally to view the full flow →'}
        </p>
        <div class="overflow-x-auto rounded-xl border border-gray-200 bg-white dark:border-gray-700">
          <img
            src={withBasePath(projectSequenceDiagram)}
            alt={lang === 'ko' ? '프로필 선택 후 경계를 판정하고 fingerprint 변경 여부에 따라 런타임을 재생성한 뒤 검증 통과 시 시작하고 실패 시 중단하는 시퀀스' : 'Sequence that resolves the boundary, regenerates the runtime when its fingerprint changed, starts after verification passes, and aborts on failure'}
            class="min-w-[900px] w-full lg:min-w-0"
            loading="lazy"
          />
        </div>
      </section>
    )}

    {/* Cover Image */}
    {!isEvidenceRegister && projectCoverImage && (
      <section id={isDaesinCase ? 'visual' : undefined} class="mb-10">
        <figure>
          {isDaesinCase && <p class="mb-2 text-xs font-medium text-gray-500 dark:text-gray-400 lg:hidden">{lang === 'ko' ? '← 좌우로 스크롤해 시나리오 보기 →' : '← Scroll horizontally to view the scenario →'}</p>}
          <div class:list={[isDaesinCase ? 'overflow-x-auto' : 'overflow-hidden', 'rounded-xl', isDaesinCase && 'daesin-cover-frame']}>
            <img
              src={withBasePath(projectCoverImage)}
              alt={isDaesinCase ? (lang === 'ko' ? '합성 데이터로 재현한 날짜별 배차현황, 노선 검색, 노선 상세의 세 단계 사용 흐름' : 'Three-step user journey for dispatch overview, route search, and route detail rendered with synthetic data') : `${projectName} project cover image`}
              width={1200}
              height={630}
              sizes="(max-width: 896px) 100vw, 896px"
              class:list={['w-full object-cover', isDaesinCase && 'min-w-[760px] lg:min-w-0']}
              loading="eager"
            />
          </div>
          {isDaesinCase && <figcaption class="case-diagram-caption mt-3 text-sm text-gray-600 dark:text-gray-300">{lang === 'ko' ? '실제 React UI 구조를 고정 synthetic fixture로 재현한 사용 시나리오이며 실시간 데이터 근거로 사용하지 않습니다.' : 'This user scenario reproduces the actual React UI structure with a deterministic synthetic fixture and is not presented as evidence of live data.'}</figcaption>}
        </figure>
      </section>
    )}

    {/* Architecture Diagram */}
    {!isEvidenceRegister && !isDaesinCase && projectArchitectureDiagram && (
      <section id="architecture" class="mb-10">
        <h2 class="section-title mb-6">{lang === 'ko' ? '시스템 아키텍처' : 'System Architecture'}</h2>
        <div class="overflow-hidden rounded-xl border border-gray-200 dark:border-gray-700">
          <img
            src={withBasePath(projectArchitectureDiagram)}
            alt={`${projectName} architecture diagram`}
            class="w-full"
            loading="lazy"
          />
        </div>
      </section>
    )}

    {/* Problem Solving */}
    {projectProblemSolving && projectProblemSolving.length > 0 && (
      <section id="problems" class="mb-10">
        <h2 class="section-title mb-6">{labels.problemSolving}</h2>
        <div class="space-y-6">
          {projectProblemSolving.map((entry, idx) => (
            <div class="rounded-lg border border-gray-200 p-5 dark:border-gray-700">
              <div class="mb-3 flex items-start gap-3">
                <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-primary-100 text-xs font-bold text-primary-700 dark:bg-primary-900/30 dark:text-primary-300">
                  {idx + 1}
                </span>
                <h3 class="font-semibold text-gray-900 dark:text-white leading-7">
                  {entry.problem[lang]}
                </h3>
              </div>
              <div class="ml-9 space-y-3">
                <div>
                  <span class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">
                    {labels.problemSolvingProcess}
                  </span>
                  <p class="mt-1 text-gray-700 dark:text-gray-300 leading-7">
                    {entry.process[lang]}
                  </p>
                </div>
                <div>
                  <span class="text-xs font-semibold uppercase tracking-wide text-primary-600 dark:text-primary-400">
                    {labels.problemSolvingResult}
                  </span>
                  <p class="mt-1 font-medium text-gray-900 dark:text-white leading-7">
                    {entry.result[lang]}
                  </p>
                </div>
              </div>
              {isDaesinCase && projectScenarioEvidence?.[idx] && (
                <figure class="mt-5 overflow-hidden rounded-xl border border-gray-200 bg-stone-50 dark:border-gray-700 dark:bg-gray-900">
                  <p class="border-b border-gray-200 px-4 py-2 text-xs font-medium text-gray-500 dark:border-gray-700 dark:text-gray-400 lg:hidden">{lang === 'ko' ? '← 좌우로 스크롤해 시나리오 보기 →' : '← Scroll horizontally to view the scenario →'}</p>
                  <div class="overflow-x-auto">
                    <img
                      src={withBasePath(projectScenarioEvidence[idx].image[lang])}
                      alt={projectScenarioEvidence[idx].title[lang]}
                      width={1200}
                      height={470}
                      class="min-w-[760px] w-full lg:min-w-0"
                      loading="eager"
                    />
                  </div>
                  <figcaption class="border-t border-gray-200 px-4 py-3 text-sm text-gray-600 dark:border-gray-700 dark:text-gray-300">
                    <strong class="mr-1 text-gray-900 dark:text-white">{projectScenarioEvidence[idx].title[lang]}.</strong>
                    {projectScenarioEvidence[idx].caption[lang]}
                  </figcaption>
                </figure>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    {isDaesinCase && projectArchitectureDiagram && (
      <section id="architecture" class="mb-10">
        <h2 class="section-title mb-3">{lang === 'ko' ? '시스템 아키텍처와 운영 경계' : 'System architecture and operating boundary'}</h2>
        <p class="case-diagram-caption mb-6 text-gray-600 dark:text-gray-300">
          {lang === 'ko'
            ? '수집은 오늘 날짜를 각 정각에 독립 재조회해 crawler와 SQLite로 전달합니다. 조회는 Next.js proxy의 public route DTO branch에서 공개 필드만 투영한 뒤 Traefik과 Express active slot을 거칩니다. 인증 경로는 별도로 전달하고, 비활성 slot은 health check 통과 뒤 전환합니다.'
            : 'Collection independently rechecks the current date on each scheduled run and sends it through the crawler into SQLite. Queries project public fields in the public route DTO branch inside the Next.js proxy before passing through Traefik and the active Express slot. Authenticated routes pass separately, and the inactive slot must pass health checks before switching.'}
        </p>
        <p class="mb-2 text-xs font-medium text-gray-500 dark:text-gray-400 lg:hidden">
          {lang === 'ko' ? '← 좌우로 스크롤해 수집·조회·배포 흐름 전체 보기 →' : '← Scroll horizontally to view the collection, query, and deployment flows →'}
        </p>
        <div class="overflow-x-auto rounded-xl border border-gray-200 bg-white dark:border-gray-700">
          <img
            src={withBasePath(projectArchitectureDiagram)}
            alt={lang === 'ko' ? '오늘 날짜 독립 재조회 수집 흐름, Next.js proxy의 public route DTO branch 조회 흐름, health-gated slot switch와 manual rollback 경계' : 'Current-date independent recheck flow, public route DTO branch inside the Next.js proxy, and the health-gated slot switch with manual rollback'}
            class="min-w-[760px] w-full lg:min-w-0"
            loading="eager"
          />
        </div>
      </section>
    )}

    {isDaesinCase && projectOperationalLimits && projectOperationalLimits.length > 0 && (
      <section id="limits" class="mb-10" aria-labelledby="limits-title">
        <h2 id="limits-title" class="section-title mb-6">{lang === 'ko' ? '운영 한계' : 'Operating limits'}</h2>
        <div class="grid gap-3 md:grid-cols-3">
          {projectOperationalLimits.map((limit) => (
            <article class="rounded-lg border-l-4 border-amber-500 bg-amber-50 p-4 text-sm leading-6 text-gray-700 dark:bg-amber-950/20 dark:text-gray-300">
              {limit}
            </article>
          ))}
        </div>
      </section>
    )}

    {isDaesinCase && projectPublicEvidence && projectPublicEvidence.length > 0 && (
      <section id="public-evidence" class="mb-10" aria-labelledby="public-evidence-title">
        <h2 id="public-evidence-title" class="section-title mb-3">{lang === 'ko' ? 'Claim → 공개 근거' : 'Claim → public evidence'}</h2>
        <p class="mb-6 text-sm text-gray-600 dark:text-gray-300">
          {lang === 'ko' ? '저장소 홈이 아니라 각 주장과 직접 연결되는 코드·테스트·CI를 제공합니다.' : 'Each claim links directly to public code, tests, or CI rather than only to a repository home page.'}
        </p>
        <div class="grid gap-3 md:grid-cols-2">
          {projectPublicEvidence.map((evidence) => (
            <article class="rounded-lg border border-gray-200 p-4 dark:border-gray-700">
              <h3 class="font-semibold text-gray-900 dark:text-white">{evidence.claim[lang]}</h3>
              <p class="mt-1 text-sm text-gray-600 dark:text-gray-300">{evidence.question[lang]}</p>
              <div class="mt-3 flex flex-wrap gap-3">
                <a class="inline-flex items-center gap-1 text-sm font-semibold text-primary-700 underline-offset-4 hover:underline dark:text-primary-300" href={evidence.url} target="_blank" rel="noopener noreferrer">
                  {evidence.label}<ExternalLinkIcon class="h-4 w-4" />
                </a>
                {evidence.testLabel && evidence.testUrl && (
                  <a class="inline-flex items-center gap-1 text-sm font-semibold text-primary-700 underline-offset-4 hover:underline dark:text-primary-300" href={evidence.testUrl} target="_blank" rel="noopener noreferrer">
                    {evidence.testLabel}<ExternalLinkIcon class="h-4 w-4" />
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>
    )}


    {/* Description */}
    {projectDescription && !isDaesinCase && (
      <section id="description" class="mb-10">
        <h2 class="section-title mb-6">{labels.description}</h2>
        <p class="text-gray-700 dark:text-gray-300 leading-relaxed">{projectDescription}</p>
      </section>
    )}

    {/* Team Composition */}
    {teamComposition && (
      <section id="team" class="mb-10">
        <h2 class="section-title mb-6">{labels.teamComposition}</h2>
        <p class="text-gray-700 dark:text-gray-300">{teamComposition}</p>
      </section>
    )}

    {/* Collaboration Tools */}
    {project.collaborationTools && project.collaborationTools.length > 0 && (
      <section id="collaboration" class="mb-10">
        <h2 class="section-title mb-4">{labels.collaborationTools}</h2>
        <div class="flex flex-wrap gap-2">
           {project.collaborationTools.map((tool: string) => (
            <span class="tech-badge">
              {tool}
            </span>
          ))}
        </div>
      </section>
    )}

    <!-- Highlights -->
    {!isDaesinCase && projectHighlights && projectHighlights.length > 0 && (
      <section id="highlights" class="mb-10">
        <h2 class="section-title mb-6">{labels.highlights}</h2>
        <ul class="space-y-3">
          {projectHighlights.map((highlight: string) => (
            <li class="flex items-start gap-3 text-gray-700 dark:text-gray-300">
              <CheckIcon class="mt-1.5 h-4 w-4 flex-shrink-0 text-primary-500" />
              <span class="leading-7">{highlight}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* Metrics */}
    {!isEvidenceRegister && !isDaesinCase && project.metrics && project.metrics.length > 0 && (
      <section id="outcomes" class="mb-10">
        <h2 class="section-title mb-6">{labels.metrics}</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead>
              <tr class="border-b border-gray-200 dark:border-gray-700">
                <th class="pb-3 pr-4 font-semibold text-gray-900 dark:text-white">{labels.metrics}</th>
                <th class="pb-3 pr-4 font-semibold text-gray-900 dark:text-white">{lang === 'ko' ? '이전' : 'Before'}</th>
                <th class="pb-3 font-semibold text-gray-900 dark:text-white">{lang === 'ko' ? '이후' : 'After'}</th>
              </tr>
            </thead>
            <tbody>
              {project.metrics.map((m) => (
                <tr class="border-b border-gray-100 dark:border-gray-800">
                  <td class="py-3 pr-4 text-gray-700 dark:text-gray-300">{m.label[lang]}</td>
                  <td class="py-3 pr-4 text-gray-500 dark:text-gray-400">{localize(m.before)}</td>
                  <td class="py-3 font-semibold text-primary-600 dark:text-primary-400">
                    {localize(m.after)} <span class="text-xs font-normal text-gray-500 dark:text-gray-400">({localize(m.improvement)})</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {/* Tech Decisions */}
    {!isDaesinCase && projectTechDecisions && projectTechDecisions.length > 0 && (
      <section id="decisions" class="mb-10">
        <h2 class="section-title mb-6">{labels.techDecisions}</h2>
        <ul class="space-y-3">
          {projectTechDecisions.map((decision: string) => (
            <li class="flex items-start gap-3 text-gray-700 dark:text-gray-300">
              <span class="mt-1 flex-shrink-0 text-primary-500">&#x25B6;</span>
              <span class="leading-7">{decision}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Features (hidden when problemSolving exists) -->
    {!projectProblemSolving && projectFeatures && projectFeatures.length > 0 && (
      <section id="features" class="mb-10">
        <h2 class="section-title mb-6">{labels.features}</h2>
        <ul class="space-y-3">
          {projectFeatures.map((feature: string) => (
            <li class="flex items-start gap-3 text-gray-700 dark:text-gray-300">
              <CheckIcon class="mt-1.5 h-4 w-4 flex-shrink-0 text-green-500" />
              <span class="leading-7">{feature}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Lessons Learned -->
    {!isDaesinCase && projectLessons && projectLessons.length > 0 && (
      <section id="lessons" class="mb-10">
        <h2 class="section-title mb-6">{labels.lessons}</h2>
        <ul class="space-y-3">
          {projectLessons.map((lesson: string) => (
            <li class="flex items-start gap-3 text-gray-700 dark:text-gray-300">
              <span class="mt-1 flex-shrink-0 text-amber-500 dark:text-amber-400">&#x2022;</span>
              <span class="leading-7">{lesson}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* Glossary */}
    {projectGlossary && projectGlossary.length > 0 && (
      <section id="glossary" class="mb-10">
        <h2 class="section-title mb-3">{lang === 'ko' ? '용어 풀이' : 'Glossary'}</h2>
        <p class="mb-6 text-gray-600 dark:text-gray-300">
          {lang === 'ko'
            ? '비전문가도 시스템의 역할을 이해할 수 있도록 핵심 용어를 먼저 설명합니다.'
            : 'Core terms are explained before the technical stack so non-specialists can follow the system.'}
        </p>
        <dl class="case-glossary">
          {projectGlossary.map((entry) => (
            <div class="case-glossary-entry">
              <dt>{entry.term[lang] || entry.term.ko}</dt>
              <dd>{entry.definition[lang] || entry.definition.ko}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    <!-- Tech Stack -->
    {project.skills && project.skills.length > 0 && (
      <section id="stack" class="mb-10">
        <h2 class="section-title mb-6">{labels.skills}</h2>
        <div class="flex flex-wrap gap-2">
           {project.skills.map((tech: string) => (
            <span class="tech-badge">
              {tech}
            </span>
          ))}
        </div>
      </section>
    )}

    <!-- Related Blog Posts -->
    {project.blogPosts && project.blogPosts.length > 0 && (
      <section id="related-posts" class="mb-10">
        <h2 class="section-title mb-6">{labels.relatedPosts}</h2>
        <ul class="space-y-3">
          {project.blogPosts.map((post: BlogPost) => {
            const postTitle = post.title[lang] || post.title.ko || post.title;
            return (
              <li>
                <span class="text-gray-700 dark:text-gray-300">{postTitle}</span>
                <a
                  href={post.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex align-middle ml-1 text-gray-500 hover:text-primary-600 dark:text-gray-300 dark:hover:text-primary-400"
                  aria-label={postTitle + (lang === 'ko' ? ' 링크' : ' link')}
                >
                  {post.url.includes('youtube.com') || post.url.includes('youtu.be') ? (
                    <YouTubeIcon class="h-4 w-4" />
                  ) : post.url.includes('jnp.tech') || post.url.includes('blog') || post.url.includes('tistory') || post.url.includes('github.io') ? (
                    <BlogIcon class="h-4 w-4" />
                  ) : (
                    <ExternalLinkIcon class="h-4 w-4" />
                  )}
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )}

    <!-- Related Links -->
    {!isEvidenceRegister && project.links && Object.keys(project.links).length > 0 && (
      <section id="related-links" class="mb-10">
        <h2 class="section-title mb-6">{labels.relatedLinks}</h2>
        <ul class="space-y-3">
          {Object.entries(project.links).map(([key, url]) => (
            typeof url === 'string' && (
              <li>
                <span class="capitalize text-gray-700 dark:text-gray-300">{key.replace(/([A-Z])/g, ' $1').trim()}</span>
                <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex align-middle ml-1 text-gray-500 hover:text-primary-600 dark:text-gray-300 dark:hover:text-primary-400"
                  aria-label={key.replace(/([A-Z])/g, ' $1').trim() + (lang === 'ko' ? ' 링크' : ' link')}
                >
                  <ExternalLinkIcon class="h-4 w-4" />
                </a>
              </li>
            )
          ))}
        </ul>
      </section>
    )}

    <!-- Content Images -->
    {project.contentImages && project.contentImages.length > 0 && (
      <section id="project-images" class="mb-10">
        <h2 class="section-title mb-6">{labels.projectImages}</h2>
        <div class="grid gap-4 sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-3">
          {project.contentImages.map((imageUrl: string, idx: number) => (
            <a href={withBasePath(imageUrl)} target="_blank" rel="noopener noreferrer" class="group overflow-hidden rounded-lg border border-gray-200 dark:border-gray-700">
              <img 
                src={withBasePath(imageUrl)}
                alt={`${projectName} screenshot ${idx + 1}`}
                width={600}
                height={400}
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                class="h-48 w-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              />
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Navigation -->
    <nav class="mt-12 border-t border-gray-200 pt-8 dark:border-gray-700">
      <div class="flex items-center justify-between">
        {prevProject ? (
          <a 
            href={`${localePrefix}/portfolio/${prevProject.slug}`}
            class="group flex items-center gap-2 text-gray-600 transition-colors hover:text-primary-600 dark:text-gray-300 dark:hover:text-primary-400"
          >
            <ArrowLeftIcon class="h-5 w-5 flex-shrink-0 transition-transform group-hover:-translate-x-1" />
            <div class="text-left">
              <p class="text-xs text-gray-500 dark:text-gray-300">{labels.previousProject}</p>
              <p class="font-medium">{prevProject.name[lang] || prevProject.name.ko}</p>
            </div>
          </a>
        ) : (
          <div></div>
        )}
        
        <a 
          href={`${localePrefix}/portfolio`}
          class="rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-100 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-800"
        >
          {labels.backToPortfolio}
        </a>
        
        {nextProject ? (
          <a 
            href={`${localePrefix}/portfolio/${nextProject.slug}`}
            class="group flex items-center gap-2 text-gray-600 transition-colors hover:text-primary-600 dark:text-gray-300 dark:hover:text-primary-400"
          >
            <div class="text-right">
              <p class="text-xs text-gray-500 dark:text-gray-300">{labels.nextProject}</p>
              <p class="font-medium">{nextProject.name[lang] || nextProject.name.ko}</p>
            </div>
            <ArrowRightIcon class="h-5 w-5 flex-shrink-0 transition-transform group-hover:translate-x-1" />
          </a>
        ) : (
          <div></div>
        )}
      </div>
    </nav>
  </article>
</Layout>
