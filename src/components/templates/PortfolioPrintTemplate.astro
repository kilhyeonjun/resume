---
import { getEntry } from 'astro:content';
import { prepareResumeData } from '../../utils/resume-data';
import { getLocalePrefix, withBasePath } from '../../utils/paths';
import rawPortfolioData from '../../data/portfolio.json';
import { portfolioDataSchema } from '../../types/portfolio';
import { selectFeaturedPortfolioProjects, selectListedPortfolioProjects } from '../../utils/portfolio-visibility';

interface Props {
  lang: 'ko' | 'en';
}

const { lang } = Astro.props;

const entry = await getEntry(`resume-${lang}`, 'main');
if (!entry) {
  throw new Error(`Resume data not found for lang: ${lang}`);
}
const resumeData = entry.data;
const { data } = prepareResumeData(resumeData, lang, 'print');

const portfolioData = portfolioDataSchema.parse(rawPortfolioData);
const { projects, labels } = portfolioData;
const currentLabels = labels[lang];

const featuredProjects = selectFeaturedPortfolioProjects(projects);
const listedProjects = selectListedPortfolioProjects(projects);

const localePrefix = getLocalePrefix(lang);
const portfolioUrl = new URL(`${localePrefix}/portfolio`, Astro.site).toString();

const email = 'kboxstar@gmail.com';

const pageTitle = lang === 'ko' ? '포트폴리오' : 'Portfolio';
const localize = (value: string | { ko: string; en: string }) => typeof value === 'string' ? value : (value[lang] || value.ko);

function formatPeriod(period: { start: string; end: string }): string {
  const fmt = (d: string) => d.replace(/-/g, '.').substring(0, 7);
  const end = period.end === 'present' ? (lang === 'ko' ? '진행 중' : 'Present') : fmt(period.end);
  return `${fmt(period.start)} — ${end}`;
}
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="robots" content="noindex, follow">
  <link rel="icon" type="image/svg+xml" href={withBasePath('favicon.svg')}>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{data.name} - {pageTitle}</title>

  <style>
    @page { margin: 10mm; size: A4; }

    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      font-size: 100%;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    body {
      font-family: 'Pretendard Variable', Pretendard, -apple-system, sans-serif;
      font-size: 9pt;
      color: #111827;
      line-height: 1.4;
      background: #fff;
      word-break: keep-all;
      overflow-wrap: break-word;
    }

    a { color: inherit; text-decoration: none; }
    a[href^="http"] { color: #2563eb; text-decoration: underline; text-underline-offset: 2px; }

    .document {
      width: 210mm;
      max-width: none;
      margin: 0 auto;
      padding: 0;
    }

    /* Header */
    .doc-header {
      margin-bottom: 5mm;
      padding-bottom: 3mm;
      border-bottom: 1.5pt solid #111827;
    }

    .doc-name {
      font-size: 16pt;
      font-weight: 700;
      color: #111827;
    }

    .doc-title {
      font-size: 11pt;
      font-weight: 600;
      color: #2563eb;
      margin-top: 1mm;
    }

    .doc-contact {
      font-size: 8.5pt;
      color: #6b7280;
      margin-top: 2mm;
      display: flex;
      flex-wrap: wrap;
      gap: 3mm;
    }

    .doc-contact a {
      color: #2563eb;
    }

    /* Section heading */
    .section-heading {
      font-size: 11pt;
      font-weight: 700;
      color: #2563eb;
      margin: 5mm 0 2mm;
      padding-bottom: 1mm;
      border-bottom: 0.5pt solid #e5e7eb;
    }

    /* Featured project */
    .project-item {
      margin-bottom: 4mm;
    }

    .project-item:first-of-type {
      /* Allow first project to break across page 1-2 so header isn't isolated */
    }

    .project-separator {
      border: none;
      border-top: 0.5pt solid #e5e7eb;
      margin: 4mm 0;
    }

    .project-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 1mm;
      break-after: avoid-page;
    }

    .project-header + .project-links {
      break-before: avoid-page;
    }

    .project-name {
      font-size: 13pt;
      font-weight: 700;
      color: #2563eb;
    }

    .project-meta {
      font-size: 8.5pt;
      color: #6b7280;
      white-space: nowrap;
      flex-shrink: 0;
      margin-left: 3mm;
    }

    .project-links {
      font-size: 8.5pt;
      color: #2563eb;
      margin-bottom: 1.5mm;
      display: flex;
      flex-wrap: wrap;
      gap: 3mm;
      break-after: avoid-page;
    }

    .project-summary {
      font-size: 9pt;
      color: #374151;
      margin-bottom: 2mm;
      break-before: avoid-page;
    }

    /* Tech stack badges */
    .tech-stack {
      display: flex;
      flex-wrap: wrap;
      gap: 1mm;
      margin-bottom: 2mm;
    }

    .tech-badge {
      display: inline-block;
      font-size: 8pt;
      color: #374151;
      background: #f3f4f6;
      padding: 0.5mm 2mm;
      border-radius: 1.5mm;
      line-height: 1.4;
    }

    /* Architecture diagram */
    .arch-diagram {
      margin: 2mm 0;
      break-inside: avoid;
    }

    .arch-diagram img {
      width: 100%;
      border: 0.5pt solid #e5e7eb;
      border-radius: 2mm;
    }

    .scenario-strip {
      margin: 2mm 0 1mm;
      break-inside: avoid;
    }

    .scenario-strip img {
      display: block;
      width: 100%;
      border: 0.5pt solid #e5e7eb;
      border-radius: 2mm;
    }

    .scenario-strip figcaption {
      margin-top: 0.7mm;
      color: #6b7280;
      font-size: 7pt;
    }

    .daesin-print-footer {
      display: grid;
      grid-template-columns: 1.3fr 0.7fr;
      gap: 3mm;
      margin-top: 1.5mm;
      break-inside: avoid;
    }

    .bullet-list.compact li {
      margin-bottom: 0.5mm;
      font-size: 7.4pt;
      line-height: 1.35;
    }

    .evidence-links-line {
      display: flex;
      flex-wrap: wrap;
      gap: 1mm 2mm;
      font-size: 7.4pt;
      line-height: 1.35;
    }

    .evidence-links-line a {
      color: #166534;
      text-decoration: none;
      font-weight: 600;
    }

    .evidence-register-print .arch-diagram {
      text-align: center;
    }

    .evidence-register-print .arch-diagram img {
      width: 130mm;
      max-width: 100%;
    }

    .evidence-register-print .project-summary {
      margin-bottom: 1mm;
    }

    .evidence-register-print .ps-entry {
      margin-bottom: 1mm;
    }

    .evidence-register-print {
      break-after: page;
    }

    /* Scale badge */
    .scale-badge {
      display: inline-block;
      font-size: 8pt;
      color: #166534;
      background: #f0fdf4;
      border: 0.5pt solid #bbf7d0;
      padding: 0.5mm 2mm;
      border-radius: 1.5mm;
      margin-bottom: 1.5mm;
      break-after: avoid-page;
    }

    /* Metrics table */
    .metric-table {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
      font-size: 8.5pt;
      margin: 1.5mm 0;
      break-inside: avoid;
    }

    .metric-table col:nth-child(1) { width: 40%; }
    .metric-table col:nth-child(2) { width: 20%; }
    .metric-table col:nth-child(3) { width: 40%; }

    .metric-table th {
      text-align: left;
      font-weight: 600;
      color: #374151;
      border-bottom: 0.5pt solid #e5e7eb;
      padding: 0.5mm 1.5mm;
    }

    .metric-table td {
      padding: 0.5mm 1.5mm;
      color: #374151;
    }

    .metric-table .after-cell {
      font-weight: 700;
      color: #2563eb;
    }

    .metric-table .improvement {
      font-size: 7.5pt;
      color: #6b7280;
    }

    /* Problem Solving */
    .ps-entry {
      margin-bottom: 1.5mm;
      break-inside: avoid;
    }

    .ps-problem {
      font-size: 9pt;
      font-weight: 600;
      color: #111827;
      margin-bottom: 0.3mm;
    }

    .ps-text {
      font-size: 8.5pt;
      color: #374151;
      padding-left: 3mm;
      margin-bottom: 0.2mm;
    }

    .ps-result {
      font-size: 8.5pt;
      font-weight: 600;
      color: #2563eb;
      padding-left: 3mm;
    }

    /* Bullet lists (highlights, features, lessons) */
    .bullet-section-heading {
      font-size: 9pt;
      font-weight: 600;
      color: #374151;
      margin: 1.5mm 0 0.5mm;
      break-after: avoid-page;
    }

    .bullet-section-heading + .bullet-list {
      break-before: avoid-page;
    }

    .bullet-list {
      list-style: none;
      padding-left: 0;
      margin-bottom: 1mm;
    }

    .bullet-list li {
      font-size: 9pt;
      color: #374151;
      margin-bottom: 0.8mm;
      line-height: 1.4;
      padding-left: 3mm;
      text-indent: -3mm;
    }

    .bullet {
      color: #374151;
      margin-right: 1mm;
    }

    /* Listed projects box */
    .listed-box {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 1mm 3mm;
      border-top: 0.5pt solid #e2e8f0;
      padding-top: 2mm;
      margin-top: 2mm;
      break-inside: avoid;
    }

    .listed-box-title {
      font-size: 8.5pt;
      font-weight: 700;
      color: #374151;
    }

    .listed-project-row {
      font-size: 8pt;
      color: #4b5563;
      display: inline-flex;
      gap: 1mm;
      align-items: baseline;
      white-space: nowrap;
    }

    .listed-project-name {
      font-weight: 600;
      color: #111827;
    }

    .listed-project-type {
      color: #475569;
    }

    .listed-project-skills {
      display: none;
    }

    /* Back button (web only) */
    .back-link {
      display: block;
      text-align: center;
      padding: 16px;
      background: #f3f4f6;
      color: #1d4ed8;
      text-decoration: none;
      font-size: 14px;
    }

    .back-link:hover { background: #e5e7eb; }

    @media print {
      html { font-size: 100%; }
      .back-link, .no-print { display: none !important; }
    }
  </style>
</head>
<body>
<main>
  <a href={portfolioUrl} class="back-link no-print">&larr; {lang === 'ko' ? '포트폴리오로 돌아가기' : 'Back to Portfolio'}</a>
  <div class="no-print" style="position:fixed;bottom:24px;right:24px;display:flex;gap:8px;z-index:100;">
    <button onclick="window.print()" style="padding:10px 20px;background:#6b7280;color:#fff;border:none;border-radius:8px;cursor:pointer;font-size:14px;font-weight:600;box-shadow:0 2px 8px rgba(0,0,0,0.15);">
      {lang === 'ko' ? '인쇄' : 'Print'}
    </button>
    <a href={withBasePath(`pdf/portfolio-${lang}.pdf`)} download type="application/pdf" style="padding:10px 20px;background:#2563eb;color:#fff;border:none;border-radius:8px;cursor:pointer;font-size:14px;font-weight:600;box-shadow:0 2px 8px rgba(0,0,0,0.15);text-decoration:none;display:inline-block;">
      {lang === 'ko' ? '다운로드' : 'Download'}
    </a>
  </div>

  <div class="document">
    <!-- Header -->
    <header class="doc-header">
      <h1 class="doc-name">{data.name}</h1>
      <div class="doc-title">{data.title}</div>
      <div class="doc-contact">
        <span>{email}</span>
        <a href="https://github.com/kilhyeonjun" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        <a href="https://www.linkedin.com/in/kilhyeonjun" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
        <a href={portfolioUrl} target="_blank" rel="noopener noreferrer">{lang === 'ko' ? '웹 포트폴리오' : 'Web Portfolio'} ↗</a>
      </div>
    </header>

    <!-- Featured Projects -->
    {featuredProjects.map((project, idx) => {
      const name = project.name[lang] || project.name.ko;
      const summary = project.summary[lang] || project.summary.ko;
      const highlights = project.highlights[lang];
      const lessons = project.lessons?.[lang];
      const period = formatPeriod(project.period);
      const typeLabel = project.type === 'personal'
        ? (lang === 'ko' ? '개인' : 'Personal')
        : (lang === 'ko' ? '팀' : 'Team');
      const role = project.role?.[lang] || project.role?.ko;
      const isEvidenceRegister = project.slug === 'ai-coding-harness';
      const isDaesinCase = project.slug === 'daesin-logistics-bot';
      const coverImage = project.printScenarioImage ? localize(project.printScenarioImage) : (project.coverImage ? localize(project.coverImage) : null);
      const architectureDiagram = project.printArchitectureDiagram ? localize(project.printArchitectureDiagram) : (project.architectureDiagram ? localize(project.architectureDiagram) : null);
      const operationalLimits = project.operationalLimits?.[lang];
      const publicEvidence = project.publicEvidence;
      const detailUrl = new URL(`${localePrefix}/portfolio/${project.slug}`, Astro.site).toString();

      return (
        <>
          {idx > 0 && <hr class="project-separator" />}
          <div class:list={['project-item', isEvidenceRegister && 'evidence-register-print', isDaesinCase && 'daesin-case-print']}>
            <div class="project-header">
              <span class="project-name">{name}</span>
              <span class="project-meta">{period} · {role ? `${role} · ` : ''}{typeLabel}</span>
            </div>

            <div class="project-links">
              {project.github && !isDaesinCase && (
                <a href={project.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
              )}
              {(isEvidenceRegister || isDaesinCase) && project.links && Object.entries(project.links).map(([key, url]) => (
                typeof url === 'string' && <a href={url} target="_blank" rel="noopener noreferrer">{key} ↗</a>
              ))}
              <a href={detailUrl} target="_blank" rel="noopener noreferrer">{lang === 'ko' ? '상세 ↗' : 'Detail ↗'}</a>
              {project.blogPosts && project.blogPosts.map((post) => (
                <a href={post.url} target="_blank" rel="noopener noreferrer">{post.title[lang] || post.title.ko} ↗</a>
              ))}
            </div>

            {project.scale?.[lang] && (
              <div class="scale-badge">{project.scale[lang]}</div>
            )}

            <p class="project-summary">{summary}</p>

            {!isEvidenceRegister && !isDaesinCase && project.skills && project.skills.length > 0 && (
              <div class="tech-stack">
                {project.skills.map((skill) => (
                  <span class="tech-badge">{skill}</span>
                ))}
              </div>
            )}

            {isDaesinCase && coverImage && (
              <figure class="scenario-strip">
                <img src={withBasePath(coverImage)} alt={lang === 'ko' ? '합성 데이터로 재현한 배차현황, 검색, 상세의 사용 흐름' : 'Synthetic user journey across dispatch overview, search, and detail'} />
                <figcaption>{lang === 'ko' ? '실제 UI 구조 · 고정 synthetic fixture · 실시간 데이터 근거 아님' : 'Actual UI structure · deterministic synthetic fixture · not live-data evidence'}</figcaption>
              </figure>
            )}

            {architectureDiagram && (
              <div class="arch-diagram">
                <img src={withBasePath(architectureDiagram)} alt={isDaesinCase ? (lang === 'ko' ? '오늘 날짜 독립 재조회와 Next.js proxy의 public route DTO branch를 포함한 수집·조회·배포 경계' : 'Collection, query, and deployment boundary with current-date independent rechecks and the public route DTO branch inside the Next.js proxy') : `${name} architecture`} />
              </div>
            )}

            {project.metrics && project.metrics.length > 0 && (
              <table class="metric-table">
                <colgroup><col /><col /><col /></colgroup>
                <thead>
                  <tr>
                    <th>{currentLabels.metrics}</th>
                    <th>{lang === 'ko' ? '이전' : 'Before'}</th>
                    <th>{lang === 'ko' ? '이후' : 'After'}</th>
                  </tr>
                </thead>
                <tbody>
                  {(isDaesinCase ? project.metrics.slice(0, 3) : project.metrics).map((m) => (
                    <tr>
                      <td>{m.label[lang]}</td>
                      <td>{localize(m.before)}</td>
                      <td class="after-cell">{localize(m.after)} <span class="improvement">({localize(m.improvement)})</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}

            {!isDaesinCase && project.problemSolving && project.problemSolving.length > 0 && (
              <section class="problem-solving-print">
                <p class="bullet-section-heading">{currentLabels.problemSolving}</p>
                {(isDaesinCase ? project.problemSolving.slice(0, 3) : project.problemSolving).map((entry) => (
                  <div class="ps-entry">
                    <div class="ps-problem">{entry.problem[lang]}</div>
                    <div class="ps-text">{entry.process[lang]}</div>
                    <div class="ps-result">→ {entry.result[lang]}</div>
                  </div>
                ))}
              </section>
            )}

            {!isDaesinCase && project.techDecisions?.[lang] && project.techDecisions[lang].length > 0 && (
              <>
                <p class="bullet-section-heading">{currentLabels.techDecisions}</p>
                <ul class="bullet-list">
                  {project.techDecisions[lang].map((item) => (
                    <li><span class="bullet">&bull;</span>{item}</li>
                  ))}
                </ul>
              </>
            )}

            {isDaesinCase && operationalLimits && (
              <div class="daesin-print-footer">
                <div>
                  <p class="bullet-section-heading">{lang === 'ko' ? '운영 한계' : 'Operating limits'}</p>
                  <ul class="bullet-list compact">
                    {operationalLimits.map((item) => <li><span class="bullet">&bull;</span>{item}</li>)}
                  </ul>
                </div>
                {publicEvidence && (
                  <div>
                    <p class="bullet-section-heading">{lang === 'ko' ? '공개 근거' : 'Public evidence'}</p>
                    <p class="evidence-links-line">{publicEvidence.map((item) => (
                      <>
                        <a href={item.url} target="_blank" rel="noopener noreferrer">{item.label} ↗</a>
                        {item.testLabel && item.testUrl && <a href={item.testUrl} target="_blank" rel="noopener noreferrer">{item.testLabel} ↗</a>}
                      </>
                    ))}</p>
                  </div>
                )}
              </div>
            )}

            {!isEvidenceRegister && !isDaesinCase && highlights && highlights.length > 0 && (
              <>
                <p class="bullet-section-heading">{currentLabels.highlights}</p>
                <ul class="bullet-list">
                  {highlights.map((item) => (
                    <li><span class="bullet">&bull;</span>{item}</li>
                  ))}
                </ul>
              </>
            )}

            {!isEvidenceRegister && !isDaesinCase && lessons && lessons.length > 0 && (
              <>
                <p class="bullet-section-heading">{currentLabels.lessons}</p>
                <ul class="bullet-list">
                  {lessons.slice(0, 2).map((item) => (
                    <li><span class="bullet">&bull;</span>{item}</li>
                  ))}
                </ul>
              </>
            )}
          </div>
        </>
      );
    })}

    <!-- Listed Projects Box -->
    {listedProjects.length > 0 && (
      <div class="listed-box">
        <div class="listed-box-title">{lang === 'ko' ? '기타 프로젝트' : 'Other Projects'}</div>
        {listedProjects.map((project) => {
          const name = project.name[lang] || project.name.ko;
          const typeLabel = project.type === 'personal'
            ? (lang === 'ko' ? '개인' : 'Personal')
            : (lang === 'ko' ? '팀' : 'Team');
          const topSkills = project.skills.slice(0, 4).join(', ');
          const detailUrl = new URL(`${localePrefix}/portfolio/${project.slug}`, Astro.site).toString();

          return (
            <div class="listed-project-row">
              <span class="listed-project-name">{name}</span>
              <span class="listed-project-type">({typeLabel})</span>
              <span class="listed-project-skills">— {topSkills}</span>
              <a href={detailUrl} target="_blank" rel="noopener noreferrer">{lang === 'ko' ? '상세 ↗' : 'Detail ↗'}</a>
            </div>
          );
        })}
      </div>
    )}
  </div>
</main>
</body>
</html>
