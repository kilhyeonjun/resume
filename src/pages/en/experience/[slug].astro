---
import { getEntry } from 'astro:content';
import ExperienceDetailTemplate from '../../../components/templates/ExperienceDetailTemplate.astro';
import { prepareResumeData } from '../../../utils/resume-data';

export async function getStaticPaths() {
  const entry = await getEntry('resume-en', 'main');
  if (!entry) {
    throw new Error('Resume data not found');
  }
  const { data, labels } = prepareResumeData(entry.data, 'en', 'experience');

  return data.experience.map((exp, index) => ({
    params: { slug: exp.slug },
    props: { 
      experience: exp, 
      index,
      total: data.experience.length,
      allExperience: data.experience,
      labels,
    }
  }));
}

const props = Astro.props;
---
<ExperienceDetailTemplate lang="en" {...props} />
