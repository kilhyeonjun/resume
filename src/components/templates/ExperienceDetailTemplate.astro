---
import Layout from '../../layouts/Layout.astro';
import ExternalLinkIcon from '../icons/ExternalLinkIcon.astro';
import YouTubeIcon from '../icons/YouTubeIcon.astro';
import BlogIcon from '../icons/BlogIcon.astro';
import CheckIcon from '../icons/CheckIcon.astro';
import ArrowLeftIcon from '../icons/ArrowLeftIcon.astro';
import ArrowRightIcon from '../icons/ArrowRightIcon.astro';
import type { Experience, Labels } from '../../content.config';
import { getBasePath } from '../../utils/paths';

interface Props {
  lang: 'ko' | 'en';
  experience: Experience;
  index: number;
  total: number;
  allExperience: Experience[];
  labels: Labels;
}

const { lang, experience, index, total, allExperience, labels } = Astro.props;
const prevExp = index > 0 ? allExperience[index - 1] : null;
const nextExp = index < total - 1 ? allExperience[index + 1] : null;

const period = experience.current
  ? `${experience.startDate.replace('-', '.')} — ${labels.current}`
  : `${experience.startDate.replace('-', '.')} — ${experience.endDate?.replace('-', '.')}`;

const basePath = getBasePath(lang);
---

<Layout title={`${experience.company} | ${experience.position}`} description={experience.description} lang={lang}>
  <article class="mx-auto max-w-4xl">
     <!-- Top Navigation: Prev / Back / Next -->
     <nav class="mb-8 flex items-center justify-between">
       {prevExp ? (
         <a
           href={`${basePath}/experience/${prevExp.slug}`}
           class="group inline-flex items-center gap-1.5 text-sm text-gray-600 transition-colors hover:text-primary-600 dark:text-gray-300 dark:hover:text-primary-400"
         >
           <ArrowLeftIcon class="h-4 w-4 transition-transform group-hover:-translate-x-0.5" />
           <span class="hidden sm:inline">{prevExp.company}</span>
           <span class="sm:hidden">{labels.previousCompany}</span>
         </a>
       ) : <div></div>}

       <a
         href={basePath}
         class="text-sm text-gray-600 transition-colors hover:text-primary-600 dark:text-gray-300 dark:hover:text-primary-400"
       >
         {labels.backToResume}
       </a>

       {nextExp ? (
         <a
           href={`${basePath}/experience/${nextExp.slug}`}
           class="group inline-flex items-center gap-1.5 text-sm text-gray-600 transition-colors hover:text-primary-600 dark:text-gray-300 dark:hover:text-primary-400"
         >
           <span class="hidden sm:inline">{nextExp.company}</span>
           <span class="sm:hidden">{labels.nextCompany}</span>
           <ArrowRightIcon class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
         </a>
       ) : <div></div>}
     </nav>

    <!-- Company Header -->
    <header class="mb-10">
      <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
        <div>
           <h1 class="text-3xl font-bold text-gray-900 dark:text-white md:text-4xl">
             {experience.companyUrl ? (
               <a 
                 href={experience.companyUrl} 
                 target="_blank" 
                 rel="noopener noreferrer"
                 class="hover:text-primary-600 dark:hover:text-primary-400"
               >
                 {experience.company}
                 <ExternalLinkIcon class="ml-1 inline-block h-5 w-5" />
               </a>
             ) : (
               experience.company
             )}
           </h1>
          <p class="mt-2 text-xl font-medium text-primary-600 dark:text-primary-400">
            {experience.position}
          </p>
        </div>
         <p class="text-sm font-medium text-gray-500 dark:text-gray-300 md:text-base">
           {period}
         </p>
       </div>
       {experience.description && (
         <p class="mt-4 text-gray-600 dark:text-gray-300">{experience.description}</p>
       )}
     </header>

     <!-- Highlights -->
     {experience.highlights && experience.highlights.length > 0 && (
       <section class="mb-10">
         <h2 class="section-title mb-6">{labels.highlights}</h2>
         <ul class="space-y-3">
            {experience.highlights.map((highlight) => (
              <li class="flex items-start gap-3 text-gray-700 dark:text-gray-300">
                <CheckIcon class="mt-1 h-5 w-5 flex-shrink-0 text-primary-500" />
                <span class="text-lg"><strong>{highlight.problem}</strong> → {highlight.solution} → <em class="text-primary-600 dark:text-primary-400">{highlight.result}</em></span>
              </li>
            ))}
         </ul>
       </section>
     )}

     <!-- Projects -->
     {experience.projects && experience.projects.length > 0 && (
       <section class="mb-10">
         <h2 class="section-title mb-6">{labels.projects}</h2>
         <div class="space-y-8">
           {experience.projects.map((project) => (
              <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-gray-800 sm:p-6">
               <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
                <h3 class="text-xl font-bold text-gray-900 dark:text-white">
                  {project.name}
                </h3>
                <span class="text-sm font-medium text-gray-500 dark:text-gray-300">
                  {project.period}
                </span>
              </div>
              <p class="mt-3 text-gray-600 dark:text-gray-300">
                {project.description}
              </p>
              {project.details && project.details.length > 0 && (
                <ul class="mt-4 space-y-2">
                  {project.details.map((detail) => (
                    <li class="flex items-start gap-2 text-gray-700 dark:text-gray-300">
                      <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-primary-500"></span>
                      <span class="leading-7">{detail}</span>
                    </li>
                  ))}
                </ul>
              )}
              {project.techStack && project.techStack.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-1.5">
                  {project.techStack.map((tech) => (
                     <span class="tech-badge">
                      {tech}
                    </span>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      </section>
    )}


     <!-- Activities -->
     {experience.activities && experience.activities.length > 0 && labels.activities && (
       <section class="mb-10">
         <h2 class="section-title mb-6">{labels.activities}</h2>
         <div class="space-y-8">
           {experience.activities.map((activity) => (
             <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-gray-800 sm:p-6">
               <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
                 <div>
                   <h3 class="text-xl font-bold text-gray-900 dark:text-white">
                     {activity.name}
                     {activity.url && (
                       <a
                         href={activity.url}
                         target="_blank"
                         rel="noopener noreferrer"
                         class="inline-flex align-middle ml-1 text-gray-500 hover:text-primary-600 dark:text-gray-300 dark:hover:text-primary-400"
                         aria-label={activity.name + (lang === 'ko' ? ' 링크' : ' link')}
                       >
                         {activity.url.includes('jnp.tech') || activity.url.includes('blog') || activity.url.includes('tistory') || activity.url.includes('github.io') ? (
                           <BlogIcon class="h-4 w-4" />
                         ) : (
                           <ExternalLinkIcon class="h-4 w-4" />
                         )}
                       </a>
                     )}
                     {activity.videoUrl && (
                       <a
                         href={activity.videoUrl}
                         target="_blank"
                         rel="noopener noreferrer"
                         class="inline-flex align-middle ml-0.5 text-gray-500 hover:text-primary-600 dark:text-gray-300 dark:hover:text-primary-400"
                         aria-label={activity.name + (lang === 'ko' ? ' 영상' : ' video')}
                       >
                         <YouTubeIcon class="h-4 w-4" />
                       </a>
                     )}
                     {activity.reviewUrl && (
                       <a
                         href={activity.reviewUrl}
                         target="_blank"
                         rel="noopener noreferrer"
                         class="inline-flex align-middle ml-0.5 text-gray-500 hover:text-primary-600 dark:text-gray-300 dark:hover:text-primary-400"
                         aria-label={activity.name + (lang === 'ko' ? ' 후기' : ' review')}
                       >
                         <ExternalLinkIcon class="h-4 w-4" />
                       </a>
                     )}
                   </h3>
                   {activity.type && (
                     <span class="mt-1 inline-block text-sm font-medium text-primary-600 dark:text-primary-400">
                       {activity.type}
                     </span>
                   )}
                 </div>
                 <span class="text-sm font-medium text-gray-500 dark:text-gray-300">
                   {activity.period}
                 </span>
               </div>
               <p class="mt-3 text-gray-600 dark:text-gray-300">
                 {activity.description}
               </p>
               {activity.achievement && (
                 <p class="mt-2 text-gray-700 dark:text-gray-200 font-medium">
                   {activity.achievement}
                 </p>
               )}
             </div>
           ))}
         </div>
       </section>
     )}

    <!-- Tech Stack -->
    {experience.techStack && experience.techStack.length > 0 && (
      <section class="mb-10">
        <h2 class="section-title mb-6">{labels.skills}</h2>
        <div class="flex flex-wrap gap-2">
          {experience.techStack.map((tech) => (
             <span class="tech-badge">
              {tech}
            </span>
          ))}
        </div>
      </section>
    )}

    <!-- Navigation -->
    <nav class="mt-12 border-t border-gray-200 pt-8 dark:border-gray-700">
      <div class="flex items-center justify-between">
         {prevExp ? (
           <a 
             href={`${basePath}/experience/${prevExp.slug}`}
             class="group flex items-center gap-2 text-gray-600 transition-colors hover:text-primary-600 dark:text-gray-300 dark:hover:text-primary-400"
           >
             <ArrowLeftIcon class="h-5 w-5 transition-transform group-hover:-translate-x-1" />
             <div class="text-left">
               <p class="text-xs text-gray-500 dark:text-gray-300">{labels.previousCompany}</p>
               <p class="font-medium">{prevExp.company}</p>
             </div>
           </a>
         ) : (
           <div></div>
         )}
        
        <a 
          href={basePath}
          class="rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-100 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-800"
        >
          {labels.backToResume}
        </a>
        
         {nextExp ? (
           <a 
             href={`${basePath}/experience/${nextExp.slug}`}
             class="group flex items-center gap-2 text-gray-600 transition-colors hover:text-primary-600 dark:text-gray-300 dark:hover:text-primary-400"
           >
             <div class="text-right">
               <p class="text-xs text-gray-500 dark:text-gray-300">{labels.nextCompany}</p>
               <p class="font-medium">{nextExp.company}</p>
             </div>
             <ArrowRightIcon class="h-5 w-5 transition-transform group-hover:translate-x-1" />
           </a>
         ) : (
           <div></div>
         )}
      </div>
    </nav>
  </article>
</Layout>
