---
import { getEntry } from 'astro:content';
import PrintFonts from '../PrintFonts.astro';
import { getHomePath, withBasePath } from '../../utils/paths';
import { prepareResumeData } from '../../utils/resume-data';

interface Props {
  lang: 'ko' | 'en';
}

const { lang } = Astro.props;
const entry = await getEntry(`resume-${lang}`, 'main');
if (!entry) throw new Error('Resume data not found');
const resumeData = entry.data;
const { data, labels } = prepareResumeData(resumeData, lang, 'experience');
const homePath = getHomePath(lang);
const pageTitle = lang === 'ko' ? '경력기술서' : 'Career Description';
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="robots" content="noindex, follow">
  <link rel="icon" type="image/svg+xml" href={withBasePath('favicon.svg')}>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{data.name} - {pageTitle}</title>
  <PrintFonts />

  <style>
    @page { margin: 10mm; size: A4; }

    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      font-size: 100%;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    body {
      font-family: 'Resume Print', sans-serif;
      font-size: 9pt;
      color: #111827;
      line-height: 1.4;
      background: #fff;
      word-break: keep-all;
      overflow-wrap: break-word;
    }

    a { color: inherit; text-decoration: none; }
    a[href^="http"] { color: #1d4ed8; text-decoration: underline; text-underline-offset: 2px; }

    .document {
      width: 210mm;
      max-width: 100%;
      margin: 0 auto;
      padding: 0;
    }

    /* Document Title */
    .doc-title {
      font-size: 16pt;
      font-weight: 700;
      text-align: center;
      margin-bottom: 6mm;
      padding-bottom: 2mm;
      border-bottom: 1pt solid #1d4ed8;
    }

    .doc-label {
      font-size: 11pt;
      font-weight: 500;
      color: #1d4ed8;
    }

    .doc-separator { font-weight: 400; color: #6b7280; }
    .doc-name { font-size: 16pt; font-weight: 700; color: #111827; }

    /* Company Section */
    .company-section {
      margin-top: 6mm;
    }

    .doc-title + .company-section {
      margin-top: 0;
    }

    .company-header {
      margin-bottom: 3mm;
      padding-bottom: 2mm;
      border-bottom: 1pt solid #d1d5db;
      break-inside: avoid;
      break-after: avoid-page;
    }

    .company-name {
      font-size: 13pt;
      font-weight: 700;
      color: #111827;
      margin-bottom: 1mm;
    }

    .company-position {
      font-size: 10pt;
      font-weight: 600;
      color: #374151;
    }

    .company-period {
      font-size: 9pt;
      color: #6b7280;
      margin-top: 0.5mm;
    }

    .company-description {
      font-size: 9pt;
      color: #374151;
      margin-top: 2mm;
      margin-bottom: 2mm;
    }

    /* Section headings */
    .section-heading {
      font-size: 11pt;
      font-weight: 700;
      color: #1d4ed8;
      margin: 4mm 0 2mm;
      padding-bottom: 1mm;
      border-bottom: 0.5pt solid #e5e7eb;
      break-after: avoid-page;
    }

    .role-section { margin-top: 3mm; }
    .role-header { margin-bottom: 1.5mm; break-inside: avoid; break-after: avoid-page; }
    .role-header + .highlights { break-before: avoid-page; }
    .highlights li { break-inside: avoid; }

    /* Highlights */
    .highlights {
      list-style: none;
      padding-left: 0;
      margin-bottom: 3mm;
    }

    .highlights li {
      font-size: 9pt;
      color: #374151;
      margin-bottom: 1mm;
      line-height: 1.4;
      padding-left: 3mm;
      text-indent: -3mm;
    }

    .highlight-bullet {
      color: #1d4ed8;
      margin-right: 1mm;
    }

    /* Technical context stays in normal weight; outcomes anchor the scan. */
    .detail-problem, .detail-solution {
      font-weight: 400;
      color: #374151;
    }

    .detail-result {
      font-weight: 700;
      color: #111827;
    }

    /* Projects */
    .project-item {
      margin-bottom: 4mm;
      break-inside: auto;
    }

    .project-header {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: baseline;
      gap: 0.5mm 3mm;
      margin-bottom: 1mm;
      break-inside: avoid;
      break-after: avoid-page;
    }

    .project-name {
      font-size: 11pt;
      font-weight: 700;
      color: #111827;
    }

    .project-period {
      font-size: 8.5pt;
      color: #6b7280;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .project-description {
      font-size: 9pt;
      color: #374151;
      margin-bottom: 1.5mm;
    }

    .project-details {
      list-style: none;
      padding-left: 0;
      margin-bottom: 1.5mm;
    }

    .project-description,
    .project-details li,
    .tech-rationale,
    .contribution,
    .tech-stack {
      break-inside: avoid;
      orphans: 2;
      widows: 2;
    }

    .project-description {
      break-before: avoid-page;
      break-after: avoid-page;
    }

    .tech-rationale-label {
      break-after: avoid-page;
    }

    .project-details li {
      font-size: 9pt;
      color: #374151;
      margin-bottom: 0.8mm;
      line-height: 1.4;
      padding-left: 3mm;
      text-indent: -3mm;
    }

    /* Tech Rationale */
    .tech-rationale {
      background: #f8f9fa;
      border: 0.5pt solid #e5e7eb;
      border-radius: 2mm;
      padding: 2mm 3mm;
      margin-bottom: 1.5mm;
    }

    .tech-rationale-label {
      font-size: 8.5pt;
      font-weight: 600;
      color: #374151;
      margin-bottom: 0.5mm;
    }

    .tech-rationale-text {
      font-size: 8.5pt;
      color: #4b5563;
      line-height: 1.4;
    }

    /* Contribution */
    .contribution {
      font-size: 8.5pt;
      font-style: italic;
      color: #4b5563;
      margin-bottom: 1.5mm;
    }

    .contribution-label {
      font-weight: 600;
      font-style: normal;
    }

    /* Tech Stack */
    .tech-stack {
      /* Keep badges with the preceding text fragment, not the entire project. */
      break-before: avoid-page;
      display: flex;
      flex-wrap: wrap;
      gap: 1mm;
      margin-top: 1mm;
    }

    .tech-badge {
      display: inline-block;
      font-size: 8pt;
      color: #374151;
      background: #f3f4f6;
      padding: 0.5mm 2mm;
      border-radius: 1.5mm;
      line-height: 1.4;
    }

    /* Activities */
    .activity-item {
      margin-bottom: 3mm;
      page-break-inside: avoid;
      break-inside: avoid;
    }

    .activity-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 0.5mm;
    }

    .activity-name {
      font-size: 10pt;
      font-weight: 600;
      color: #111827;
    }

    .activity-type {
      font-size: 8.5pt;
      color: #6b7280;
      margin-left: 2mm;
    }

    .activity-period {
      font-size: 8.5pt;
      color: #6b7280;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .activity-description {
      font-size: 9pt;
      color: #374151;
      margin-bottom: 0.5mm;
    }

    .activity-achievement {
      font-size: 9pt;
      color: #374151;
      font-weight: 500;
    }

    /* Back button (web only) */
    .back-link {
      display: block;
      text-align: center;
      padding: 16px;
      background: #f3f4f6;
      color: #1d4ed8;
      text-decoration: none;
      font-size: 14px;
    }

    .back-link:hover { background: #e5e7eb; }

    @media print {
      html { font-size: 100%; }
      .back-link, .no-print { display: none !important; }
    }
  </style>
</head>
<body>
<main>
  <a href={homePath} class="back-link no-print">&larr; {labels.backToResume}</a>
  <div class="no-print" style="position:fixed;bottom:24px;right:24px;display:flex;gap:8px;z-index:100;">
    <button onclick="window.print()" style="padding:10px 20px;background:#6b7280;color:#fff;border:none;border-radius:8px;cursor:pointer;font-size:14px;font-weight:600;box-shadow:0 2px 8px rgba(0,0,0,0.15);">
      {lang === 'ko' ? '인쇄' : 'Print'}
    </button>
    <a href={withBasePath(`pdf/career-detail-${lang}.pdf`)} download type="application/pdf" style="padding:10px 20px;background:#2563eb;color:#fff;border:none;border-radius:8px;cursor:pointer;font-size:14px;font-weight:600;box-shadow:0 2px 8px rgba(0,0,0,0.15);text-decoration:none;display:inline-block;">
      {lang === 'ko' ? '다운로드' : 'Download'}
    </a>
  </div>

  <div class="document">
    <h1 class="doc-title"><span class="doc-label">{pageTitle}</span><span class="doc-separator"> — </span><span class="doc-name">{data.name}</span></h1>

    {data.experience.map((exp) => {
      const period = exp.current
        ? `${exp.startDate.replace('-', '.')} — ${labels.current}`
        : `${exp.startDate.replace('-', '.')} — ${exp.endDate?.replace('-', '.')}`;

      return (
        <div class="company-section">
          <header class="company-header">
            <h2 class="company-name">{exp.company}</h2>
            {(!exp.positions || exp.positions.length === 0) && exp.position && (
              <p class="company-position">{exp.position}</p>
            )}
            <p class="company-period">{period}</p>
          </header>

          {exp.description && (
            <p class="company-description">{exp.description}</p>
          )}

          {exp.positions && exp.positions.length > 0 && (
            <section aria-label={labels.highlights}>
              {exp.positions.map((pos) => (
                <section class="role-section">
                  <header class="role-header">
                    <h3 class="company-position">{pos.title}</h3>
                    <p class="company-period">{pos.startDate.replace('-', '.')} — {pos.current ? labels.current : pos.endDate?.replace('-', '.')}</p>
                  </header>
                  {pos.highlights && pos.highlights.length > 0 && (
                    <ul class="highlights">
                      {pos.highlights.map((highlight) => (
                        <li><span class="highlight-bullet">&bull;</span><span class="detail-problem">{highlight.problem}</span>. <span class="detail-solution">{highlight.solution}</span>. <strong class="detail-result">{highlight.result}</strong>.</li>
                      ))}
                    </ul>
                  )}
                </section>
              ))}
            </section>
          )}

          {exp.highlights && exp.highlights.length > 0 && (
            <>
              <h3 class="section-heading">{labels.highlights}</h3>
              <ul class="highlights">
                {exp.highlights.map((highlight) => (
                  <li><span class="highlight-bullet">&bull;</span><span class="detail-problem">{highlight.problem}</span>. <span class="detail-solution">{highlight.solution}</span>. <strong class="detail-result">{highlight.result}</strong>.</li>
                ))}
              </ul>
            </>
          )}

          {exp.projects && exp.projects.length > 0 && (
            <>
              <h3 class="section-heading">{labels.projects}</h3>
              {exp.projects.map((project) => (
                <div class="project-item">
                  <div class="project-header">
                    <h4 class="project-name">{project.name}</h4>
                    <span class="project-period">{project.period}</span>
                  </div>
                  <p class="project-description">{project.description}</p>
                  {project.details && project.details.length > 0 && (
                    <ul class="project-details">
                      {project.details.map((detail) => (
                        <li><span class="highlight-bullet">&bull;</span><span class="detail-problem">{detail.problem}</span> — <span class="detail-solution">{detail.solution}</span>, <strong class="detail-result">{detail.result}</strong></li>
                      ))}
                    </ul>
                  )}
                  {project.techRationale && (
                    <div class="tech-rationale">
                      <p class="tech-rationale-label">{lang === 'ko' ? '기술 선택 이유' : 'Tech Rationale'}</p>
                      <p class="tech-rationale-text">{project.techRationale}</p>
                    </div>
                  )}
                  {project.contribution && (
                    <p class="contribution">
                      <span class="contribution-label">{lang === 'ko' ? '기여도' : 'Contribution'}:</span> {project.contribution}
                    </p>
                  )}
                  {project.techStack && project.techStack.length > 0 && (
                    <div class="tech-stack">
                      {project.techStack.map((tech) => (
                        <span class="tech-badge">{tech}</span>
                      ))}
                    </div>
                  )}
                </div>
              ))}
            </>
          )}

          {exp.activities && exp.activities.length > 0 && labels.activities && (
            <>
              <h3 class="section-heading">{labels.activities}</h3>
              {exp.activities.map((activity) => (
                <div class="activity-item">
                  <div class="activity-header">
                    <span>
                      <span class="activity-name">{activity.name}</span>
                      {activity.type && <span class="activity-type">{activity.type}</span>}
                    </span>
                    <span class="activity-period">{activity.period}</span>
                  </div>
                  <p class="activity-description">{activity.description}</p>
                  {activity.achievement && (
                    <p class="activity-achievement">{activity.achievement}</p>
                  )}
                </div>
              ))}
            </>
          )}
        </div>
      );
    })}
  </div>
</main>
</body>
</html>
