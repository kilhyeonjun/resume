---
import Layout from '../../layouts/Layout.astro';
import ExternalLinkIcon from '../icons/ExternalLinkIcon.astro';
import BlogIcon from '../icons/BlogIcon.astro';
import YouTubeIcon from '../icons/YouTubeIcon.astro';
import CheckIcon from '../icons/CheckIcon.astro';
import ArrowLeftIcon from '../icons/ArrowLeftIcon.astro';
import ArrowRightIcon from '../icons/ArrowRightIcon.astro';
import GitHubIcon from '../icons/GitHubIcon.astro';
import type { PortfolioProject, PortfolioLabels, BlogPost } from '../../types/portfolio';
import { getLocalePrefix, withBasePath } from '../../utils/paths';

interface Props {
  lang: 'ko' | 'en';
  project: PortfolioProject;
  index: number;
  total: number;
  allProjects: PortfolioProject[];
  labels: PortfolioLabels;
}

const { lang, project, index, total, allProjects, labels } = Astro.props;
const prevProject = index > 0 ? allProjects[index - 1] : null;
const nextProject = index < total - 1 ? allProjects[index + 1] : null;

const period = `${project.period.start} — ${project.period.end}`;
const localePrefix = getLocalePrefix(lang);

const localize = (value: string | { ko: string; en: string }) => typeof value === 'string' ? value : (value[lang] || value.ko);
const projectName = project.name[lang] || project.name.ko;
const projectSummary = project.summary[lang] || project.summary.ko;
const projectHighlights = project.highlights[lang] || project.highlights.ko;
const teamComposition = project.teamComposition ? (project.teamComposition[lang] || project.teamComposition.ko) : null;
const projectDescription = project.description ? (project.description[lang] || project.description.ko) : null;
const projectFeatures = project.features ? (project.features[lang] || project.features.ko) : null;
const projectLessons = project.lessons ? (project.lessons[lang] || project.lessons.ko) : null;
const projectTechDecisions = project.techDecisions ? (project.techDecisions[lang] || project.techDecisions.ko) : null;
const projectScale = project.scale ? (project.scale[lang] || project.scale.ko) : null;
const projectRole = project.role ? (project.role[lang] || project.role.ko) : null;
const projectGlossary = project.glossary ?? null;
const projectProblemSolving = project.problemSolving ?? null;
const projectCoverImage = project.coverImage ? localize(project.coverImage) : null;
const projectArchitectureDiagram = project.architectureDiagram ? localize(project.architectureDiagram) : null;
const isEvidenceRegister = project.slug === 'ai-coding-harness';
---

<Layout title={`${projectName} | Portfolio`} description={projectSummary} lang={lang}>
  <article class:list={['detail-dossier portfolio-detail', isEvidenceRegister && 'case-study-evidence-register']}>
    <!-- Back to Portfolio -->
    <nav class="mb-8">
      <a 
        href={`${localePrefix}/portfolio`}
        class="touch-target group inline-flex items-center gap-2 text-sm text-gray-600 hover:text-primary-600 dark:text-gray-300 dark:hover:text-primary-400"
      >
        <ArrowLeftIcon class="h-4 w-4 transition-transform group-hover:-translate-x-0.5" />
        {labels.backToPortfolio}
      </a>
    </nav>

    <!-- Project Header -->
    <header class="mb-10">
      <div class="project-heading mb-6 flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
        <div>
          <div class="mb-2 flex items-center gap-2">
            <span class={`inline-block rounded-full px-3 py-1 text-xs font-medium ${project.type === 'team' ? 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300' : 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300'}`}>
              {project.type === 'team' ? labels.team : labels.personal}
            </span>
            {projectScale && (
              <span class="inline-block rounded-full border border-emerald-300 bg-emerald-50 px-3 py-1 text-xs font-medium text-emerald-700 dark:border-emerald-700 dark:bg-emerald-900/20 dark:text-emerald-300">
                {projectScale}
              </span>
            )}
          </div>
          <h1 class="text-3xl font-bold text-gray-900 dark:text-white md:text-4xl">
            {projectName}
          </h1>
          {projectRole && (
            <p class="project-role mt-3 text-sm font-semibold text-primary-700 dark:text-primary-300">
              {projectRole}
            </p>
          )}
        </div>
        <p class="text-sm font-medium text-gray-500 dark:text-gray-300 md:text-base">
          {period}
        </p>
      </div>
      <p class="project-summary mt-4 text-lg text-gray-600 dark:text-gray-300">{projectSummary}</p>
      
      {/* GitHub & Links */}
      <div class="project-proof-links mt-6 flex flex-wrap gap-3">
        {project.github && (
          <a 
            href={project.github} 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center gap-2 rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-gray-700 dark:bg-gray-100 dark:text-gray-900 dark:hover:bg-gray-300"
          >
            <GitHubIcon class="h-4 w-4" />
            {labels.github}
          </a>
        )}
        {isEvidenceRegister && project.links && Object.entries(project.links).map(([key, url]) => (
          typeof url === 'string' && (
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-primary-700 transition-colors hover:border-primary-400 hover:bg-primary-50 dark:border-gray-600 dark:bg-gray-900 dark:text-primary-300 dark:hover:border-primary-500"
            >
              {key}
              <ExternalLinkIcon class="h-4 w-4" />
            </a>
          )
        ))}
      </div>
      <nav class="evidence-index" aria-label={lang === 'ko' ? '프로젝트 근거 목차' : 'Project evidence index'}>
        {project.metrics && project.metrics.length > 0 && <a href="#outcomes"><span>01</span>{labels.metrics}</a>}
        {isEvidenceRegister && projectArchitectureDiagram && <a href="#boundary"><span>02</span>{lang === 'ko' ? '프로필 경계' : 'Profile boundary'}</a>}
        {projectProblemSolving && projectProblemSolving.length > 0 && <a href="#problems"><span>{isEvidenceRegister ? '03' : '02'}</span>{labels.problemSolving}</a>}
        {projectTechDecisions && projectTechDecisions.length > 0 && <a href="#decisions"><span>{isEvidenceRegister ? '04' : '03'}</span>{labels.techDecisions}</a>}
        {projectGlossary && projectGlossary.length > 0
          ? <a href="#glossary"><span>05</span>{lang === 'ko' ? '용어 풀이' : 'Glossary'}</a>
          : project.skills && project.skills.length > 0 && <a href="#stack"><span>04</span>{labels.skills}</a>}
      </nav>
    </header>

    {isEvidenceRegister && project.metrics && project.metrics.length > 0 && (
      <section id="outcomes" class="mb-10 case-outcomes" aria-labelledby="outcomes-title">
        <h2 id="outcomes-title" class="section-title mb-6">{lang === 'ko' ? '검증된 변화' : 'Verified changes'}</h2>
        <div class="outcome-register">
          {project.metrics.map((metric) => (
            <article class="outcome-register-entry">
              <p class="outcome-register-label">{metric.label[lang]}</p>
              <h3>{localize(metric.after)}</h3>
              <p class="outcome-register-impact">{localize(metric.improvement)}</p>
              <p class="outcome-register-before"><strong>{lang === 'ko' ? '이전' : 'Before'}:</strong> {localize(metric.before)}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    {isEvidenceRegister && projectArchitectureDiagram && (
      <section id="boundary" class="mb-10 case-boundary">
        <h2 class="section-title mb-3">{lang === 'ko' ? '프로필 경계와 근거 검증' : 'Profile boundaries and evidence verification'}</h2>
        <p class="case-diagram-caption mb-6 text-gray-600 dark:text-gray-300">
          {lang === 'ko'
            ? '검색 결과는 답이 아니라 후보입니다. 선택한 프로필 안에서 후보를 찾고 원문을 다시 확인합니다.'
            : 'Retrieval results are candidates, not answers. Candidates stay inside the selected profile and are checked against the original source.'}
        </p>
        <div class="overflow-hidden rounded-xl border border-gray-200 dark:border-gray-700">
          <img
            src={withBasePath(projectArchitectureDiagram)}
            alt={lang === 'ko' ? '개발자, 프로필 기반 실행기, 개인 업무 플랫폼 경계, AI 런타임, RAG KG, 원문 검증과 실행 게이트 관계도' : 'Context diagram connecting developer, profile-aware launcher, Personal Work Platform boundaries, AI runtimes, RAG KG, source verification, and execution gates'}
            class="w-full"
            loading="eager"
          />
        </div>
      </section>
    )}

    {/* Cover Image */}
    {!isEvidenceRegister && projectCoverImage && (
      <section class="mb-10">
        <div class="overflow-hidden rounded-xl">
          <img 
            src={withBasePath(projectCoverImage)}
            alt={`${projectName} project cover image`}
            width={1200}
            height={630}
            sizes="(max-width: 896px) 100vw, 896px"
            class="w-full object-cover"
            loading="eager"
          />
        </div>
      </section>
    )}

    {/* Architecture Diagram */}
    {!isEvidenceRegister && projectArchitectureDiagram && (
      <section class="mb-10">
        <h2 class="section-title mb-6">{labels.techDecisions ? (lang === 'ko' ? '시스템 아키텍처' : 'System Architecture') : 'Architecture'}</h2>
        <div class="overflow-hidden rounded-xl border border-gray-200 dark:border-gray-700">
          <img
            src={withBasePath(projectArchitectureDiagram)}
            alt={`${projectName} architecture diagram`}
            class="w-full"
            loading="lazy"
          />
        </div>
      </section>
    )}

    {/* Problem Solving */}
    {projectProblemSolving && projectProblemSolving.length > 0 && (
      <section id="problems" class="mb-10">
        <h2 class="section-title mb-6">{labels.problemSolving}</h2>
        <div class="space-y-6">
          {projectProblemSolving.map((entry, idx) => (
            <div class="rounded-lg border border-gray-200 p-5 dark:border-gray-700">
              <div class="mb-3 flex items-start gap-3">
                <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-primary-100 text-xs font-bold text-primary-700 dark:bg-primary-900/30 dark:text-primary-300">
                  {idx + 1}
                </span>
                <h3 class="font-semibold text-gray-900 dark:text-white leading-7">
                  {entry.problem[lang]}
                </h3>
              </div>
              <div class="ml-9 space-y-3">
                <div>
                  <span class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">
                    {labels.problemSolvingProcess}
                  </span>
                  <p class="mt-1 text-gray-700 dark:text-gray-300 leading-7">
                    {entry.process[lang]}
                  </p>
                </div>
                <div>
                  <span class="text-xs font-semibold uppercase tracking-wide text-primary-600 dark:text-primary-400">
                    {labels.problemSolvingResult}
                  </span>
                  <p class="mt-1 font-medium text-gray-900 dark:text-white leading-7">
                    {entry.result[lang]}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    {isEvidenceRegister && projectCoverImage && (
      <section id="sequence" class="mb-10 case-sequence">
        <h2 class="section-title mb-3">{lang === 'ko' ? '설치와 검증 흐름' : 'Install and verification flow'}</h2>
        <p class="case-diagram-caption mb-6 text-gray-600 dark:text-gray-300">
          {lang === 'ko'
            ? '프로필 선택부터 원문 확인과 실패 시 중단하는 실행 게이트까지 이어지는 대표 흐름입니다.'
            : 'A representative flow from profile selection through source verification to fail-closed execution gates.'}
        </p>
        <div class="overflow-hidden rounded-xl border border-gray-200 dark:border-gray-700">
          <img
            src={withBasePath(projectCoverImage)}
            alt={lang === 'ko' ? '프로필 선택, 격리 런타임 준비, 근거 후보 검색, 원문 확인, 실패 시 중단하는 실행 게이트 순서도' : 'Sequence from profile selection to isolated runtime, evidence retrieval, source verification, and fail-closed execution gates'}
            class="w-full"
            loading="lazy"
          />
        </div>
      </section>
    )}

    {/* Description */}
    {projectDescription && (
      <section class="mb-10">
        <h2 class="section-title mb-6">{labels.description}</h2>
        <p class="text-gray-700 dark:text-gray-300 leading-relaxed">{projectDescription}</p>
      </section>
    )}

    {/* Team Composition */}
    {teamComposition && (
      <section class="mb-10">
        <h2 class="section-title mb-6">{labels.teamComposition}</h2>
        <p class="text-gray-700 dark:text-gray-300">{teamComposition}</p>
      </section>
    )}

    {/* Collaboration Tools */}
    {project.collaborationTools && project.collaborationTools.length > 0 && (
      <section class="mb-10">
        <h2 class="section-title mb-4">{labels.collaborationTools}</h2>
        <div class="flex flex-wrap gap-2">
           {project.collaborationTools.map((tool: string) => (
            <span class="tech-badge">
              {tool}
            </span>
          ))}
        </div>
      </section>
    )}

    <!-- Highlights -->
    {projectHighlights && projectHighlights.length > 0 && (
      <section class="mb-10">
        <h2 class="section-title mb-6">{labels.highlights}</h2>
        <ul class="space-y-3">
          {projectHighlights.map((highlight: string) => (
            <li class="flex items-start gap-3 text-gray-700 dark:text-gray-300">
              <CheckIcon class="mt-1.5 h-4 w-4 flex-shrink-0 text-primary-500" />
              <span class="leading-7">{highlight}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* Metrics */}
    {!isEvidenceRegister && project.metrics && project.metrics.length > 0 && (
      <section id="outcomes" class="mb-10">
        <h2 class="section-title mb-6">{labels.metrics}</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead>
              <tr class="border-b border-gray-200 dark:border-gray-700">
                <th class="pb-3 pr-4 font-semibold text-gray-900 dark:text-white">{labels.metrics}</th>
                <th class="pb-3 pr-4 font-semibold text-gray-900 dark:text-white">{lang === 'ko' ? '이전' : 'Before'}</th>
                <th class="pb-3 font-semibold text-gray-900 dark:text-white">{lang === 'ko' ? '이후' : 'After'}</th>
              </tr>
            </thead>
            <tbody>
              {project.metrics.map((m) => (
                <tr class="border-b border-gray-100 dark:border-gray-800">
                  <td class="py-3 pr-4 text-gray-700 dark:text-gray-300">{m.label[lang]}</td>
                  <td class="py-3 pr-4 text-gray-500 dark:text-gray-400">{localize(m.before)}</td>
                  <td class="py-3 font-semibold text-primary-600 dark:text-primary-400">
                    {localize(m.after)} <span class="text-xs font-normal text-gray-500 dark:text-gray-400">({localize(m.improvement)})</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {/* Tech Decisions */}
    {projectTechDecisions && projectTechDecisions.length > 0 && (
      <section id="decisions" class="mb-10">
        <h2 class="section-title mb-6">{labels.techDecisions}</h2>
        <ul class="space-y-3">
          {projectTechDecisions.map((decision: string) => (
            <li class="flex items-start gap-3 text-gray-700 dark:text-gray-300">
              <span class="mt-1 flex-shrink-0 text-primary-500">&#x25B6;</span>
              <span class="leading-7">{decision}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Features (hidden when problemSolving exists) -->
    {!projectProblemSolving && projectFeatures && projectFeatures.length > 0 && (
      <section class="mb-10">
        <h2 class="section-title mb-6">{labels.features}</h2>
        <ul class="space-y-3">
          {projectFeatures.map((feature: string) => (
            <li class="flex items-start gap-3 text-gray-700 dark:text-gray-300">
              <CheckIcon class="mt-1.5 h-4 w-4 flex-shrink-0 text-green-500" />
              <span class="leading-7">{feature}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Lessons Learned -->
    {projectLessons && projectLessons.length > 0 && (
      <section class="mb-10">
        <h2 class="section-title mb-6">{labels.lessons}</h2>
        <ul class="space-y-3">
          {projectLessons.map((lesson: string) => (
            <li class="flex items-start gap-3 text-gray-700 dark:text-gray-300">
              <span class="mt-1 flex-shrink-0 text-amber-500 dark:text-amber-400">&#x2022;</span>
              <span class="leading-7">{lesson}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* Glossary */}
    {projectGlossary && projectGlossary.length > 0 && (
      <section id="glossary" class="mb-10">
        <h2 class="section-title mb-3">{lang === 'ko' ? '용어 풀이' : 'Glossary'}</h2>
        <p class="mb-6 text-gray-600 dark:text-gray-300">
          {lang === 'ko'
            ? '비전문가도 시스템의 역할을 이해할 수 있도록 핵심 용어를 먼저 설명합니다.'
            : 'Core terms are explained before the technical stack so non-specialists can follow the system.'}
        </p>
        <dl class="case-glossary">
          {projectGlossary.map((entry) => (
            <div class="case-glossary-entry">
              <dt>{entry.term[lang] || entry.term.ko}</dt>
              <dd>{entry.definition[lang] || entry.definition.ko}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    <!-- Tech Stack -->
    {project.skills && project.skills.length > 0 && (
      <section id="stack" class="mb-10">
        <h2 class="section-title mb-6">{labels.skills}</h2>
        <div class="flex flex-wrap gap-2">
           {project.skills.map((tech: string) => (
            <span class="tech-badge">
              {tech}
            </span>
          ))}
        </div>
      </section>
    )}

    <!-- Related Blog Posts -->
    {project.blogPosts && project.blogPosts.length > 0 && (
      <section class="mb-10">
        <h2 class="section-title mb-6">{labels.relatedPosts}</h2>
        <ul class="space-y-3">
          {project.blogPosts.map((post: BlogPost) => {
            const postTitle = post.title[lang] || post.title.ko || post.title;
            return (
              <li>
                <span class="text-gray-700 dark:text-gray-300">{postTitle}</span>
                <a
                  href={post.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex align-middle ml-1 text-gray-500 hover:text-primary-600 dark:text-gray-300 dark:hover:text-primary-400"
                  aria-label={postTitle + (lang === 'ko' ? ' 링크' : ' link')}
                >
                  {post.url.includes('youtube.com') || post.url.includes('youtu.be') ? (
                    <YouTubeIcon class="h-4 w-4" />
                  ) : post.url.includes('jnp.tech') || post.url.includes('blog') || post.url.includes('tistory') || post.url.includes('github.io') ? (
                    <BlogIcon class="h-4 w-4" />
                  ) : (
                    <ExternalLinkIcon class="h-4 w-4" />
                  )}
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )}

    <!-- Related Links -->
    {!isEvidenceRegister && project.links && Object.keys(project.links).length > 0 && (
      <section class="mb-10">
        <h2 class="section-title mb-6">{labels.relatedLinks}</h2>
        <ul class="space-y-3">
          {Object.entries(project.links).map(([key, url]) => (
            typeof url === 'string' && (
              <li>
                <span class="capitalize text-gray-700 dark:text-gray-300">{key.replace(/([A-Z])/g, ' $1').trim()}</span>
                <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex align-middle ml-1 text-gray-500 hover:text-primary-600 dark:text-gray-300 dark:hover:text-primary-400"
                  aria-label={key.replace(/([A-Z])/g, ' $1').trim() + (lang === 'ko' ? ' 링크' : ' link')}
                >
                  <ExternalLinkIcon class="h-4 w-4" />
                </a>
              </li>
            )
          ))}
        </ul>
      </section>
    )}

    <!-- Content Images -->
    {project.contentImages && project.contentImages.length > 0 && (
      <section class="mb-10">
        <h2 class="section-title mb-6">{labels.projectImages}</h2>
        <div class="grid gap-4 sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-3">
          {project.contentImages.map((imageUrl: string, idx: number) => (
            <a href={withBasePath(imageUrl)} target="_blank" rel="noopener noreferrer" class="group overflow-hidden rounded-lg border border-gray-200 dark:border-gray-700">
              <img 
                src={withBasePath(imageUrl)}
                alt={`${projectName} screenshot ${idx + 1}`}
                width={600}
                height={400}
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                class="h-48 w-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              />
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Navigation -->
    <nav class="mt-12 border-t border-gray-200 pt-8 dark:border-gray-700">
      <div class="flex items-center justify-between">
        {prevProject ? (
          <a 
            href={`${localePrefix}/portfolio/${prevProject.slug}`}
            class="group flex items-center gap-2 text-gray-600 transition-colors hover:text-primary-600 dark:text-gray-300 dark:hover:text-primary-400"
          >
            <ArrowLeftIcon class="h-5 w-5 transition-transform group-hover:-translate-x-1" />
            <div class="text-left">
              <p class="text-xs text-gray-500 dark:text-gray-300">{labels.previousProject}</p>
              <p class="font-medium">{prevProject.name[lang] || prevProject.name.ko}</p>
            </div>
          </a>
        ) : (
          <div></div>
        )}
        
        <a 
          href={`${localePrefix}/portfolio`}
          class="rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-100 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-800"
        >
          {labels.backToPortfolio}
        </a>
        
        {nextProject ? (
          <a 
            href={`${localePrefix}/portfolio/${nextProject.slug}`}
            class="group flex items-center gap-2 text-gray-600 transition-colors hover:text-primary-600 dark:text-gray-300 dark:hover:text-primary-400"
          >
            <div class="text-right">
              <p class="text-xs text-gray-500 dark:text-gray-300">{labels.nextProject}</p>
              <p class="font-medium">{nextProject.name[lang] || nextProject.name.ko}</p>
            </div>
            <ArrowRightIcon class="h-5 w-5 transition-transform group-hover:translate-x-1" />
          </a>
        ) : (
          <div></div>
        )}
      </div>
    </nav>
  </article>
</Layout>
