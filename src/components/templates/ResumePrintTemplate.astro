---
import { getEntry } from 'astro:content';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import { getBasePath } from '../../utils/paths';
import { prepareResumeData } from '../../utils/resume-data';

interface Props {
  lang: 'ko' | 'en';
}

const { lang } = Astro.props;

const entry = await getEntry(`resume-${lang}`, 'main');
if (!entry) {
  throw new Error('Resume data not found');
}
const resumeData = entry.data;

const { data, labels } = prepareResumeData(resumeData, lang);

const basePath = getBasePath(lang);
const pageTitle = lang === 'ko' ? '이력서' : 'Resume';
const resumeUrl = `https://kilhyeonjun.github.io/resume${lang === 'en' ? '/en' : ''}`;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{data.name} - {pageTitle}</title>

  <style>
    @page { margin: 10mm 0 8mm 0; size: A4; }
    @page :first { margin-top: 0; margin-bottom: 0; }

    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      font-size: 100%;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    body {
      font-family: 'Inter', 'Apple SD Gothic Neo', 'Malgun Gothic', -apple-system, sans-serif;
      font-size: 9pt;
      color: #111827;
      line-height: 1.55;
      background: #fff;
      word-break: keep-all;
      overflow-wrap: break-word;
    }

    a { color: inherit; text-decoration: none; }

    .resume {
      width: 210mm;
      max-width: none;
      margin: 0 auto;
      padding: 10mm 13mm 12mm;
    }

    /* Header */
    .header {
      text-align: center;
      margin-bottom: 4mm;
      padding-bottom: 2mm;
      border-bottom: 1pt solid #1d4ed8;
    }

    .name {
      font-size: 20pt;
      font-weight: 700;
      color: #111827;
      letter-spacing: -0.01em;
    }

    .title {
      font-size: 10pt;
      font-weight: 600;
      color: #1d4ed8;
      margin-top: 1mm;
    }

    .contact-info {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      column-gap: 4mm;
      row-gap: 1mm;
      margin-top: 2mm;
      font-size: 8pt;
      line-height: 1.35;
      color: #4b5563;
    }

    .contact-item {
      display: flex;
      align-items: center;
      gap: 3px;
    }

    .contact-link { color: #1d4ed8; }

    /* Section styles */
    section { margin-bottom: 4mm; }

    .section-title {
      font-size: 11pt;
      font-weight: 700;
      text-transform: none;
      letter-spacing: 0.06em;
      color: #1d4ed8;
      margin: 0 0 2mm;
      padding: 0 0 1mm;
      border-bottom: 0.6pt solid #e5e7eb;
    }

    /* Summary */
    .summary-text {
      font-size: 9pt;
      color: #1f2937;
      white-space: pre-line;
      line-height: 1.55;
    }

    /* Experience */
    .experience-item {
      margin-bottom: 3.5mm;
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .experience-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 0.5mm;
    }

    .position { font-size: 10pt; font-weight: 700; color: #111827; min-width: 0; }
    .date { font-size: 8pt; color: #6b7280; white-space: nowrap; flex-shrink: 0; }
    .company { font-size: 9pt; font-weight: 600; color: #1d4ed8; margin-bottom: 1mm; }
    .company a { color: #1d4ed8; }
    .description { font-size: 8pt; color: #374151; margin-bottom: 1.5mm; }

    .highlights { list-style: none; padding-left: 0; margin-bottom: 1mm; }

    .highlights li {
      font-size: 9pt;
      color: #374151;
      margin-bottom: 0.5mm;
      line-height: 1.5;
    }

    .highlight-bullet { color: #1d4ed8; margin-right: 4px; }

    /* Two-column grid */
    .two-col-grid {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      column-gap: 8mm;
      row-gap: 2mm;
      align-items: start;
      break-inside: avoid;
      page-break-inside: avoid;
    }

    /* Skills */
    .skill-group { margin-bottom: 1.5mm; font-size: 9pt; line-height: 1.45; }
    .skill-category { font-weight: 600; color: #4b5563; }
    .skill-inline { color: #374151; }

    /* Education */
    .education-item { margin-bottom: 2mm; }
    .institution { font-size: 9pt; font-weight: 600; color: #111827; }
    .degree { font-size: 8pt; color: #1d4ed8; }
    .edu-date { font-size: 8pt; color: #6b7280; }

    /* Certifications & Learning */
    .cert-item { margin-bottom: 2mm; }
    .cert-name { font-size: 9pt; font-weight: 600; color: #111827; }
    .cert-issuer { font-size: 8pt; color: #6b7280; }

    /* Open Source */
    .opensource-inline { font-size: 9pt; color: #374151; line-height: 1.45; }

    /* Technical Writing */
    .tw-item { margin-bottom: 1.5mm; }
    .tw-title { font-size: 9pt; font-weight: 600; color: #111827; }
    .tw-title a { color: #111827; }
    .tw-meta { font-size: 8pt; color: #6b7280; }
    .tw-desc { font-size: 8pt; color: #374151; margin-top: 1pt; }

    /* Back button (web only) */
    .back-link {
      display: block;
      text-align: center;
      padding: 16px;
      background: #f3f4f6;
      color: #1d4ed8;
      text-decoration: none;
      font-size: 14px;
    }

    .back-link:hover { background: #e5e7eb; }

    @media print {
      html { font-size: 100%; }
      .back-link, .no-print { display: none !important; }
    }
  </style>
</head>
<body>
  <a href={basePath} class="back-link no-print">← {labels.backToResume}</a>

  <div class="resume">
    <!-- Header -->
    <header class="header">
      <h1 class="name">{data.name}</h1>
      <p class="title">{data.title}</p>
      <div class="contact-info">
        {data.email && (
          <span class="contact-item">{data.email}</span>
        )}
        {data.location && (
          <span class="contact-item">{data.location}</span>
        )}
        {data.github && (
          <a href={data.github} class="contact-item contact-link">{data.github.replace('https://', '')}</a>
        )}
        {data.linkedin && (
          <a href={data.linkedin} class="contact-item contact-link">{data.linkedin.replace('https://', '')}</a>
        )}
        {data.blog && (
          <a href={data.blog} class="contact-item contact-link">{data.blog.replace('https://', '')}</a>
        )}
        <a href={resumeUrl} class="contact-item contact-link">{lang === 'ko' ? '이력서 웹' : 'Resume Web'}</a>
        <a href={`${resumeUrl}/portfolio`} class="contact-item contact-link">{lang === 'ko' ? '포트폴리오' : 'Portfolio'}</a>
      </div>
    </header>

    <!-- Summary -->
    {data.summary && (
      <section>
        <h2 class="section-title">{labels.summary}</h2>
        <p class="summary-text">{data.summary}</p>
      </section>
    )}

    <!-- Experience -->
    {data.experience && data.experience.length > 0 && (
      <section>
        <h2 class="section-title">{labels.experience}</h2>
        {data.experience.map((exp) => (
          <div class="experience-item">
            <div class="experience-header">
              <span class="position">{exp.position}</span>
              <span class="date">{exp.startDate.replace('-', '.')} — {exp.current ? labels.current : exp.endDate?.replace('-', '.')}</span>
            </div>
            <p class="company">
              <a href={`${resumeUrl}/experience/${exp.slug}`}>{exp.company}</a>
            </p>
            {exp.description && (
              <p class="description">{exp.description}</p>
            )}
            {exp.highlights && exp.highlights.length > 0 && (
              <ul class="highlights">
                {exp.highlights.map((highlight) => (
                  <li><span class="highlight-bullet">•</span>{highlight}</li>
                ))}
              </ul>
            )}

          </div>
        ))}
      </section>
    )}

    <!-- Skills + Education (2-column grid) -->
    <div class="two-col-grid">
      <!-- Skills (left) -->
      {data.skills && data.skills.length > 0 && (
        <section>
          <h2 class="section-title">{labels.skills}</h2>
          {data.skills.map((skillGroup) => (
            <div class="skill-group">
              <span class="skill-category">{skillGroup.category}:</span>{' '}
              <span class="skill-inline">{skillGroup.items.map(s => s.name).join(', ')}</span>
            </div>
          ))}
        </section>
      )}

      <!-- Education (right) -->
      {data.education && data.education.length > 0 && (
        <section>
          <h2 class="section-title">{labels.education}</h2>
          {data.education.map((edu) => (
            <div class="education-item">
              <h3 class="institution">{edu.institution}</h3>
              <p class="degree">{edu.degree} {edu.field && `• ${edu.field}`}</p>
              <p class="edu-date">
                {edu.startDate.replace('-', '.')} — {edu.endDate.replace('-', '.')}
                {edu.gpa && ` | GPA: ${edu.gpa}`}
              </p>
            </div>
          ))}
        </section>
      )}
    </div>

    <!-- Certifications + Continuous Learning (2-column grid) -->
    <div class="two-col-grid">
      <!-- Certifications (left) -->
      {data.certifications && data.certifications.length > 0 && (
        <section>
          <h2 class="section-title">{labels.certifications}</h2>
          {data.certifications.map((cert) => (
            <div class="cert-item">
              <h3 class="cert-name">{cert.name}</h3>
              <p class="cert-issuer">{cert.issuer} • {cert.date.replace('-', '.')}</p>
            </div>
          ))}
        </section>
      )}

      <!-- Continuous Learning (right) -->
      {data.continuousLearning && data.continuousLearning.length > 0 && (
        <section>
          <h2 class="section-title">{labels.continuousLearning}</h2>
          {data.continuousLearning.map((item) => (
            <div class="cert-item">
              <h3 class="cert-name">{item.name} — {item.description}</h3>
              <p class="cert-issuer">{item.period}</p>
            </div>
          ))}
        </section>
      )}
    </div>

    <!-- Open Source (inline 1 line) -->
    {data.openSource && data.openSource.length > 0 && (
      <section>
        <h2 class="section-title">{labels.openSource}</h2>
        <p class="opensource-inline">
          {lang === 'ko' ? `오픈소스 기여 ${data.openSource.length}건` : `${data.openSource.length} open source contributions`}
          {' — '}
          {[...new Set(data.openSource.map((item) => item.name.split(':')[0].trim()))].join(', ')}
        </p>
      </section>
    )}

    <!-- Technical Writing -->
    {data.technicalWriting && data.technicalWriting.length > 0 && (
      <section>
        <h2 class="section-title">{labels.technicalWriting}</h2>
        {data.technicalWriting.map((item) => {
          const linkUrl = item.url || item.videoUrl || item.reviewUrl;
          return (
            <div class="tw-item">
              <h3 class="tw-title">
                {linkUrl ? (
                  <a href={linkUrl}>{item.title}</a>
                ) : item.title}
              </h3>
              <p class="tw-meta">{item.type} — {item.date.replace('-', '.')}</p>
              {item.description && (
                <p class="tw-desc">{item.description}</p>
              )}
            </div>
          );
        })}
      </section>
    )}
  </div>
</body>
</html>
