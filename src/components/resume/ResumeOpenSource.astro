---
import GitHubIcon from '../icons/GitHubIcon.astro';
import { groupOpenSourceByRepo, parseOpenSourceName } from '../../utils/open-source';

interface Props {
  openSource: OpenSource[];
  label: string;
}

const { openSource, label } = Astro.props;

// Group by repo name
const grouped = groupOpenSourceByRepo(openSource);
---

<section>
  <h2 class="section-title">{label}</h2>
  <div class="mt-6 space-y-5">
    {Object.entries(grouped).map(([repo, { repoUrl, items }]) => {
      return (
        <div>
          <h3 class="font-semibold text-gray-900 dark:text-white">
            {repo}
            {repoUrl && (
              <a
                href={repoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex align-middle ml-1 text-gray-500 hover:text-primary-600 dark:text-gray-300 dark:hover:text-primary-400"
                aria-label={repo + ' GitHub'}
              >
                <GitHubIcon class="h-4 w-4" />
              </a>
            )}
          </h3>
          <ul class="mt-1 ml-4 space-y-1">
            {items.map((item) => {
              const { description: desc } = parseOpenSourceName(item.name);
              return (
                <li class="text-sm text-gray-600 dark:text-gray-300 flex items-start gap-1.5">
                  <span class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-gray-400 dark:bg-gray-500" />
                  <span>
                    {desc}
                    {item.url && (
                      <a
                        href={item.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex align-middle ml-0.5 text-gray-500 hover:text-primary-600 dark:text-gray-300 dark:hover:text-primary-400"
                        aria-label={desc + ' GitHub'}
                      >
                        <GitHubIcon class="h-3.5 w-3.5" />
                      </a>
                    )}
                    {' '}
                    <span class="text-gray-500 dark:text-gray-300 whitespace-nowrap">({item.date})</span>
                  </span>
                </li>
              );
            })}
          </ul>
        </div>
      );
    })}
  </div>
</section>
