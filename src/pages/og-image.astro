---
import { getEntry } from 'astro:content';

const entry = await getEntry('resume-ko', 'main');
const data = entry!.data;
const { name, title } = data.personalInfo;
const categories = data.coreCompetencies.map((c: { category: string }) => c.category);
---

<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <link
    href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    rel="stylesheet"
  />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body {
      width: 1200px;
      height: 630px;
      overflow: hidden;
      font-family: 'Pretendard Variable', sans-serif;
    }
    .container {
      width: 1200px;
      height: 630px;
      background: linear-gradient(135deg, #1e3a5f 0%, #2563eb 50%, #3b82f6 100%);
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 80px 100px;
      position: relative;
    }
    .name {
      font-size: 64px;
      font-weight: 700;
      color: #ffffff;
      letter-spacing: -0.5px;
      margin-bottom: 12px;
    }
    .title {
      font-size: 32px;
      font-weight: 400;
      color: rgba(255, 255, 255, 0.85);
      margin-bottom: 40px;
    }
    .divider {
      width: 80px;
      height: 3px;
      background: rgba(255, 255, 255, 0.5);
      margin-bottom: 32px;
    }
    .categories {
      font-size: 18px;
      font-weight: 400;
      color: rgba(255, 255, 255, 0.7);
      line-height: 1.6;
    }
    .url {
      position: absolute;
      bottom: 40px;
      left: 100px;
      font-size: 16px;
      color: rgba(255, 255, 255, 0.5);
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="name">{name}</div>
    <div class="title">{title}</div>
    <div class="divider"></div>
    <div class="categories">{categories.join(' · ')}</div>
    <div class="url">kilhyeonjun.github.io/resume</div>
  </div>
</body>
</html>
