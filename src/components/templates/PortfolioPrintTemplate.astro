---
import rawPortfolioData from '../../data/portfolio.json';
import { portfolioDataSchema } from '../../types/portfolio';

interface Props {
  lang: 'ko' | 'en';
}

const { lang } = Astro.props;

const portfolioData = portfolioDataSchema.parse(rawPortfolioData);
const { projects, labels } = portfolioData;
const currentLabels = labels[lang];

const featuredProjects = projects
  .filter((p) => p.featured && !p.hidden)
  .sort((a, b) => (a.printOrder ?? 99) - (b.printOrder ?? 99));
const listedProjects = projects.filter((p) => p.listed && !p.hidden);

const baseUrl = 'https://kilhyeonjun.github.io/resume';

const personalInfo = {
  ko: { name: '길현준', title: 'Node.js Developer' },
  en: { name: 'Hyeonjun Kil', title: 'Node.js Developer' },
};
const info = personalInfo[lang];
const email = 'kboxstar@gmail.com';

const pageTitle = lang === 'ko' ? '포트폴리오' : 'Portfolio';

function formatPeriod(period: { start: string; end: string }): string {
  const fmt = (d: string) => d.replace(/-/g, '.').substring(0, 7);
  const end = period.end === 'present' ? (lang === 'ko' ? '진행 중' : 'Present') : fmt(period.end);
  return `${fmt(period.start)} — ${end}`;
}
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{info.name} - {pageTitle}</title>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  <style>
    @page { margin: 10mm; size: A4; }

    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      font-size: 100%;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    body {
      font-family: 'Pretendard Variable', Pretendard, -apple-system, sans-serif;
      font-size: 9pt;
      color: #111827;
      line-height: 1.4;
      background: #fff;
      word-break: keep-all;
      overflow-wrap: break-word;
    }

    a { color: inherit; text-decoration: none; }
    a[href^="http"] { color: #2563eb; text-decoration: underline; text-underline-offset: 2px; }

    .document {
      width: 210mm;
      max-width: none;
      margin: 0 auto;
      padding: 0;
    }

    /* Header */
    .doc-header {
      margin-bottom: 5mm;
      padding-bottom: 3mm;
      border-bottom: 1.5pt solid #111827;
    }

    .doc-name {
      font-size: 16pt;
      font-weight: 700;
      color: #111827;
    }

    .doc-title {
      font-size: 11pt;
      font-weight: 600;
      color: #2563eb;
      margin-top: 1mm;
    }

    .doc-contact {
      font-size: 8.5pt;
      color: #6b7280;
      margin-top: 2mm;
      display: flex;
      flex-wrap: wrap;
      gap: 3mm;
    }

    .doc-contact a {
      color: #2563eb;
    }

    /* Section heading */
    .section-heading {
      font-size: 11pt;
      font-weight: 700;
      color: #2563eb;
      margin: 5mm 0 2mm;
      padding-bottom: 1mm;
      border-bottom: 0.5pt solid #e5e7eb;
    }

    /* Featured project */
    .project-item {
      margin-bottom: 4mm;
    }

    .project-item:first-of-type {
      page-break-inside: avoid;
      break-inside: avoid;
    }

    .project-separator {
      border: none;
      border-top: 0.5pt solid #e5e7eb;
      margin: 4mm 0;
    }

    .project-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 1mm;
    }

    .project-name {
      font-size: 13pt;
      font-weight: 700;
      color: #2563eb;
    }

    .project-meta {
      font-size: 8.5pt;
      color: #6b7280;
      white-space: nowrap;
      flex-shrink: 0;
      margin-left: 3mm;
    }

    .project-links {
      font-size: 8.5pt;
      color: #2563eb;
      margin-bottom: 1.5mm;
      display: flex;
      flex-wrap: wrap;
      gap: 3mm;
    }

    .project-summary {
      font-size: 9pt;
      color: #374151;
      margin-bottom: 2mm;
    }

    /* Tech stack badges */
    .tech-stack {
      display: flex;
      flex-wrap: wrap;
      gap: 1mm;
      margin-bottom: 2mm;
    }

    .tech-badge {
      display: inline-block;
      font-size: 8pt;
      color: #374151;
      background: #f3f4f6;
      padding: 0.5mm 2mm;
      border-radius: 1.5mm;
      line-height: 1.4;
    }

    /* Bullet lists (highlights, features, lessons) */
    .bullet-section-heading {
      font-size: 9pt;
      font-weight: 600;
      color: #374151;
      margin: 1.5mm 0 0.5mm;
    }

    .bullet-list {
      list-style: none;
      padding-left: 0;
      margin-bottom: 1mm;
    }

    .bullet-list li {
      font-size: 9pt;
      color: #374151;
      margin-bottom: 0.8mm;
      line-height: 1.4;
      padding-left: 3mm;
      text-indent: -3mm;
    }

    .bullet {
      color: #374151;
      margin-right: 1mm;
    }

    /* Listed projects box */
    .listed-box {
      background: #f8fafc;
      border: 0.5pt solid #e2e8f0;
      border-radius: 2mm;
      padding: 3mm 4mm;
      margin-top: 4mm;
    }

    .listed-box-title {
      font-size: 10pt;
      font-weight: 700;
      color: #374151;
      margin-bottom: 2mm;
    }

    .listed-project-row {
      font-size: 8.5pt;
      color: #4b5563;
      margin-bottom: 1mm;
      display: flex;
      gap: 2mm;
      align-items: baseline;
    }

    .listed-project-name {
      font-weight: 600;
      color: #111827;
    }

    .listed-project-type {
      color: #9ca3af;
    }

    .listed-project-skills {
      color: #6b7280;
      flex: 1;
    }

    /* Back button (web only) */
    .back-link {
      display: block;
      text-align: center;
      padding: 16px;
      background: #f3f4f6;
      color: #1d4ed8;
      text-decoration: none;
      font-size: 14px;
    }

    .back-link:hover { background: #e5e7eb; }

    @media print {
      html { font-size: 100%; }
      .back-link, .no-print { display: none !important; }
    }
  </style>
</head>
<body>
  <a href={`${baseUrl}/portfolio`} class="back-link no-print">&larr; {lang === 'ko' ? '포트폴리오로 돌아가기' : 'Back to Portfolio'}</a>
  <div class="no-print" style="position:fixed;bottom:24px;right:24px;display:flex;gap:8px;z-index:100;">
    <button onclick="window.print()" style="padding:10px 20px;background:#6b7280;color:#fff;border:none;border-radius:8px;cursor:pointer;font-size:14px;font-weight:600;box-shadow:0 2px 8px rgba(0,0,0,0.15);">
      {lang === 'ko' ? '인쇄' : 'Print'}
    </button>
    <a href={`${baseUrl}/pdf/portfolio-${lang}.pdf`} download type="application/pdf" style="padding:10px 20px;background:#2563eb;color:#fff;border:none;border-radius:8px;cursor:pointer;font-size:14px;font-weight:600;box-shadow:0 2px 8px rgba(0,0,0,0.15);text-decoration:none;display:inline-block;">
      {lang === 'ko' ? '다운로드' : 'Download'}
    </a>
  </div>

  <div class="document">
    <!-- Header -->
    <header class="doc-header">
      <div class="doc-name">{info.name}</div>
      <div class="doc-title">{info.title}</div>
      <div class="doc-contact">
        <span>{email}</span>
        <a href="https://github.com/kilhyeonjun" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        <a href="https://www.linkedin.com/in/kilhyeonjun" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
        <a href={`${baseUrl}/portfolio`} target="_blank" rel="noopener noreferrer">{lang === 'ko' ? '웹 포트폴리오' : 'Web Portfolio'} ↗</a>
      </div>
    </header>

    <!-- Featured Projects -->
    {featuredProjects.map((project, idx) => {
      const name = project.name[lang] || project.name.ko;
      const summary = project.summary[lang] || project.summary.ko;
      const highlights = project.highlights[lang];
      const features = project.features?.[lang];
      const lessons = project.lessons?.[lang];
      const period = formatPeriod(project.period);
      const typeLabel = project.type === 'personal'
        ? (lang === 'ko' ? '개인' : 'Personal')
        : (lang === 'ko' ? '팀' : 'Team');
      const detailUrl = `${baseUrl}/portfolio/${project.slug}`;

      return (
        <>
          {idx > 0 && <hr class="project-separator" />}
          <div class="project-item">
            <div class="project-header">
              <span class="project-name">{name}</span>
              <span class="project-meta">{period} · {typeLabel}</span>
            </div>

            <div class="project-links">
              {project.github && (
                <a href={project.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
              )}
              <a href={detailUrl} target="_blank" rel="noopener noreferrer">{lang === 'ko' ? '상세 ↗' : 'Detail ↗'}</a>
              {project.blogPosts && project.blogPosts.map((post) => (
                <a href={post.url} target="_blank" rel="noopener noreferrer">{post.title[lang] || post.title.ko} ↗</a>
              ))}
            </div>

            <p class="project-summary">{summary}</p>

            {project.skills && project.skills.length > 0 && (
              <div class="tech-stack">
                {project.skills.map((skill) => (
                  <span class="tech-badge">{skill}</span>
                ))}
              </div>
            )}

            {highlights && highlights.length > 0 && (
              <>
                <p class="bullet-section-heading">{currentLabels.highlights}</p>
                <ul class="bullet-list">
                  {highlights.map((item) => (
                    <li><span class="bullet">&bull;</span>{item}</li>
                  ))}
                </ul>
              </>
            )}

            {features && features.length > 0 && (
              <>
                <p class="bullet-section-heading">{currentLabels.features}</p>
                <ul class="bullet-list">
                  {features.map((item) => (
                    <li><span class="bullet">&bull;</span>{item}</li>
                  ))}
                </ul>
              </>
            )}

            {lessons && lessons.length > 0 && (
              <>
                <p class="bullet-section-heading">{currentLabels.lessons}</p>
                <ul class="bullet-list">
                  {lessons.map((item) => (
                    <li><span class="bullet">&bull;</span>{item}</li>
                  ))}
                </ul>
              </>
            )}
          </div>
        </>
      );
    })}

    <!-- Listed Projects Box -->
    {listedProjects.length > 0 && (
      <div class="listed-box">
        <div class="listed-box-title">{lang === 'ko' ? '기타 프로젝트' : 'Other Projects'}</div>
        {listedProjects.map((project) => {
          const name = project.name[lang] || project.name.ko;
          const typeLabel = project.type === 'personal'
            ? (lang === 'ko' ? '개인' : 'Personal')
            : (lang === 'ko' ? '팀' : 'Team');
          const topSkills = project.skills.slice(0, 4).join(', ');
          const detailUrl = `${baseUrl}/portfolio/${project.slug}`;

          return (
            <div class="listed-project-row">
              <span class="listed-project-name">{name}</span>
              <span class="listed-project-type">({typeLabel})</span>
              <span class="listed-project-skills">— {topSkills}</span>
              <a href={detailUrl} target="_blank" rel="noopener noreferrer">{lang === 'ko' ? '상세 ↗' : 'Detail ↗'}</a>
            </div>
          );
        })}
      </div>
    )}
  </div>
</body>
</html>
