---
import { getEntry } from 'astro:content';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import { getBasePath } from '../../utils/paths';
import { replaceDurationPlaceholder } from '../../utils/career-duration';

interface Props {
  lang: 'ko' | 'en';
}

const { lang } = Astro.props;

const entry = await getEntry(`resume-${lang}`, 'main');
if (!entry) {
  throw new Error('Resume data not found');
}
const resumeData = entry.data;

const data = {
  ...resumeData.personalInfo,
  summary: replaceDurationPlaceholder(resumeData.summary, resumeData.experience, lang),
  coreCompetencies: resumeData.coreCompetencies,
  skills: resumeData.skills,
  experience: resumeData.experience,
  education: resumeData.education,
  certifications: resumeData.certifications,
  continuousLearning: resumeData.continuousLearning,
  technicalWriting: resumeData.technicalWriting,
  openSource: resumeData.openSource,
  awards: resumeData.awards,
};
const labels = resumeData.labels;

const basePath = getBasePath(lang);
const pageTitle = lang === 'ko' ? '이력서' : 'Resume';
const resumeUrl = `https://kilhyeonjun.github.io/resume${lang === 'en' ? '/en' : ''}`;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{data.name} - {pageTitle}</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      font-size: 10.5px;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      color: #1f2937;
      background: #fff;
      line-height: 1.45;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .resume {
      max-width: 210mm;
      margin: 0 auto;
      padding: 10mm 14mm;
    }

    /* Header */
    .header {
      text-align: center;
      margin-bottom: 10px;
      padding-bottom: 8px;
      border-bottom: 2px solid #2563eb;
    }

    .name {
      font-size: 24px;
      font-weight: 700;
      color: #111827;
      letter-spacing: -0.025em;
    }

    .title {
      font-size: 13px;
      font-weight: 500;
      color: #2563eb;
      margin-top: 2px;
    }

    .contact-info {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 6px;
      font-size: 9.5px;
      color: #4b5563;
    }

    .contact-item {
      display: flex;
      align-items: center;
      gap: 3px;
    }

    .contact-link {
      color: #2563eb;
    }

    /* Section styles */
    section {
      margin-bottom: 8px;
    }

    .section-title {
      font-size: 11.5px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #2563eb;
      margin-bottom: 5px;
      padding-bottom: 2px;
      border-bottom: 1px solid #e5e7eb;
    }

    /* Summary */
    .summary-text {
      font-size: 10px;
      color: #374151;
      white-space: pre-line;
      line-height: 1.5;
    }

    /* Experience */
    .experience-item {
      margin-bottom: 8px;
    }

    .experience-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 1px;
    }

    .position {
      font-size: 11.5px;
      font-weight: 600;
      color: #111827;
    }

    .date {
      font-size: 9.5px;
      color: #6b7280;
      white-space: nowrap;
    }

    .company {
      font-size: 10px;
      font-weight: 500;
      color: #2563eb;
      margin-bottom: 3px;
    }

    .company a {
      color: #2563eb;
    }

    .description {
      font-size: 9.5px;
      color: #4b5563;
      margin-bottom: 3px;
    }

    .highlights {
      list-style: none;
      padding-left: 0;
      margin-bottom: 2px;
    }

    .highlights li {
      font-size: 9.5px;
      color: #374151;
      padding-left: 10px;
      position: relative;
      margin-bottom: 1px;
      line-height: 1.4;
    }

    .highlights li::before {
      content: "•";
      position: absolute;
      left: 0;
      color: #2563eb;
    }

    /* Project summary list within experience */
    .project-summary-list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1px 12px;
      margin-top: 4px;
      padding-top: 3px;
      border-top: 1px dashed #e5e7eb;
    }

    .project-summary-item {
      font-size: 8.5px;
      color: #4b5563;
      display: flex;
      justify-content: space-between;
      gap: 4px;
    }

    .project-summary-name {
      font-weight: 500;
      color: #374151;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .project-summary-period {
      color: #9ca3af;
      white-space: nowrap;
      flex-shrink: 0;
    }

    /* Two-column grid for side sections */
    .two-col-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4px 20px;
    }

    /* Skills */
    .skill-group {
      margin-bottom: 2px;
      font-size: 9.5px;
      line-height: 1.35;
    }

    .skill-category {
      font-weight: 600;
      color: #4b5563;
    }

    .skill-inline {
      color: #374151;
    }

    /* Education */
    .education-item {
      margin-bottom: 4px;
    }

    .institution {
      font-size: 10.5px;
      font-weight: 600;
      color: #111827;
    }

    .degree {
      font-size: 9.5px;
      color: #2563eb;
    }

    .edu-date {
      font-size: 8.5px;
      color: #6b7280;
    }

    /* Certifications & Learning */
    .cert-item {
      margin-bottom: 4px;
    }

    .cert-name {
      font-size: 10px;
      font-weight: 600;
      color: #111827;
    }

    .cert-issuer {
      font-size: 8.5px;
      color: #6b7280;
    }

    /* Open Source inline */
    .opensource-inline {
      font-size: 9.5px;
      color: #374151;
      line-height: 1.4;
    }

    /* Technical Writing */
    .tw-item {
      margin-bottom: 3px;
    }

    .tw-title {
      font-size: 10px;
      font-weight: 600;
      color: #111827;
    }

    .tw-title a {
      color: #111827;
    }

    .tw-meta {
      font-size: 8.5px;
      color: #6b7280;
    }

    /* Print-specific */
    @media print {
      html {
        font-size: 10px;
      }

      .resume {
        padding: 8mm 12mm;
      }

      .no-print {
        display: none !important;
      }
    }

    @page {
      margin: 0;
      size: A4;
    }

    /* Back button for web view */
    .back-link {
      display: block;
      text-align: center;
      padding: 16px;
      background: #f3f4f6;
      color: #2563eb;
      text-decoration: none;
      font-size: 14px;
    }

    .back-link:hover {
      background: #e5e7eb;
    }

    @media print {
      .back-link {
        display: none;
      }
    }
  </style>
</head>
<body>
  <a href={basePath} class="back-link no-print">← {labels.backToResume}</a>

  <div class="resume">
    <!-- Header -->
    <header class="header">
      <h1 class="name">{data.name}</h1>
      <p class="title">{data.title}</p>
      <div class="contact-info">
        {data.email && (
          <span class="contact-item">{data.email}</span>
        )}
        {data.location && (
          <span class="contact-item">{data.location}</span>
        )}
        {data.github && (
          <a href={data.github} class="contact-item contact-link">{data.github.replace('https://', '')}</a>
        )}
        {data.linkedin && (
          <a href={data.linkedin} class="contact-item contact-link">{data.linkedin.replace('https://', '')}</a>
        )}
        {data.blog && (
          <a href={data.blog} class="contact-item contact-link">{data.blog.replace('https://', '')}</a>
        )}
        <a href={resumeUrl} class="contact-item contact-link">{lang === 'ko' ? '이력서 웹' : 'Resume Web'}</a>
        <a href={`${resumeUrl}/portfolio`} class="contact-item contact-link">{lang === 'ko' ? '포트폴리오' : 'Portfolio'}</a>
      </div>
    </header>

    <!-- Summary -->
    {data.summary && (
      <section>
        <h2 class="section-title">{labels.summary}</h2>
        <p class="summary-text">{data.summary}</p>
      </section>
    )}

    <!-- Experience -->
    {data.experience && data.experience.length > 0 && (
      <section>
        <h2 class="section-title">{labels.experience}</h2>
        {data.experience.map((exp) => (
          <div class="experience-item">
            <div class="experience-header">
              <span class="position">{exp.position}</span>
              <span class="date">{exp.startDate.replace('-', '.')} — {exp.current ? labels.current : exp.endDate?.replace('-', '.')}</span>
            </div>
            <p class="company">
              <a href={`${resumeUrl}/experience/${exp.slug}`}>{exp.company}</a>
            </p>
            {exp.description && (
              <p class="description">{exp.description}</p>
            )}
            {exp.highlights && exp.highlights.length > 0 && (
              <ul class="highlights">
                {exp.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            )}
            {exp.projects && exp.projects.length > 0 && (
              <div class="project-summary-list">
                {exp.projects.map((proj) => (
                  <div class="project-summary-item">
                    <span class="project-summary-name">{proj.name}</span>
                    <span class="project-summary-period">{proj.period}</span>
                  </div>
                ))}
              </div>
            )}
          </div>
        ))}
      </section>
    )}

    <!-- Skills + Education (2-column grid) -->
    <div class="two-col-grid">
      <!-- Skills (left) -->
      {data.skills && data.skills.length > 0 && (
        <section>
          <h2 class="section-title">{labels.skills}</h2>
          {data.skills.map((skillGroup) => (
            <div class="skill-group">
              <span class="skill-category">{skillGroup.category}:</span>{' '}
              <span class="skill-inline">{skillGroup.items.map(s => s.name).join(', ')}</span>
            </div>
          ))}
        </section>
      )}

      <!-- Education (right) -->
      {data.education && data.education.length > 0 && (
        <section>
          <h2 class="section-title">{labels.education}</h2>
          {data.education.map((edu) => (
            <div class="education-item">
              <h3 class="institution">{edu.institution}</h3>
              <p class="degree">{edu.degree} {edu.field && `• ${edu.field}`}</p>
              <p class="edu-date">
                {edu.startDate.replace('-', '.')} — {edu.endDate.replace('-', '.')}
                {edu.gpa && ` | GPA: ${edu.gpa}`}
              </p>
            </div>
          ))}
        </section>
      )}
    </div>

    <!-- Certifications + Continuous Learning (2-column grid) -->
    <div class="two-col-grid">
      <!-- Certifications (left) -->
      {data.certifications && data.certifications.length > 0 && (
        <section>
          <h2 class="section-title">{labels.certifications}</h2>
          {data.certifications.map((cert) => (
            <div class="cert-item">
              <h3 class="cert-name">{cert.name}</h3>
              <p class="cert-issuer">{cert.issuer} • {cert.date}</p>
            </div>
          ))}
        </section>
      )}

      <!-- Continuous Learning (right) -->
      {data.continuousLearning && data.continuousLearning.length > 0 && (
        <section>
          <h2 class="section-title">{labels.continuousLearning}</h2>
          {data.continuousLearning.map((item) => (
            <div class="cert-item">
              <h3 class="cert-name">{item.name}</h3>
              <p class="cert-issuer">{item.period}</p>
            </div>
          ))}
        </section>
      )}
    </div>

    <!-- Open Source (inline 1 line) -->
    {data.openSource && data.openSource.length > 0 && (
      <section>
        <h2 class="section-title">{labels.openSource}</h2>
        <p class="opensource-inline">
          {lang === 'ko' ? `오픈소스 기여 ${data.openSource.length}건` : `${data.openSource.length} open source contributions`}
          {' — '}
          {[...new Set(data.openSource.map((item) => item.name.split(':')[0].trim()))].join(', ')}
        </p>
      </section>
    )}

    <!-- Technical Writing -->
    {data.technicalWriting && data.technicalWriting.length > 0 && (
      <section>
        <h2 class="section-title">{labels.technicalWriting}</h2>
        {data.technicalWriting.map((item) => {
          const linkUrl = item.url || item.videoUrl || item.reviewUrl;
          return (
            <div class="tw-item">
              <h3 class="tw-title">
                {linkUrl ? (
                  <a href={linkUrl}>{item.title}</a>
                ) : item.title}
              </h3>
              <p class="tw-meta">{item.type} — {item.date}</p>
            </div>
          );
        })}
      </section>
    )}
  </div>
</body>
</html>
