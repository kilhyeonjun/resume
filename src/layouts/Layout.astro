---
import '../styles/global.css';

import ThemeToggle from '../components/ThemeToggle.astro';
import { getBasePath } from '../utils/paths';

interface Props {
  title: string;
  description?: string;
  lang?: 'ko' | 'en';
}

const { title, description: rawDesc, lang = 'ko' } = Astro.props;
const description = rawDesc || (lang === 'en' ? 'Personal Resume and Portfolio' : '개인 이력서 및 포트폴리오');
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const basePath = getBasePath(lang);

const currentPath = Astro.url.pathname;
const isPortfolio = currentPath.startsWith(`${basePath}/portfolio`);
const isResume = !isPortfolio && (
  currentPath === basePath
  || currentPath === `${basePath}/`
  || currentPath.startsWith(`${basePath}/experience`)
  || currentPath.startsWith(`${basePath}/resume-`)
);

// Compute hreflang alternate URLs
const hrefRelativePath = currentPath.slice(basePath.length) || '/';
const koHref = `${Astro.site}resume${hrefRelativePath}`;
const enHref = `${Astro.site}resume/en${hrefRelativePath}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />

    <!-- Security Headers -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:;" />

    <!-- OG / Twitter Card -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.toString()} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta property="og:image" content={`${Astro.site}resume/og-image.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${Astro.site}resume/og-image.png`} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- hreflang -->
    <link rel="alternate" hreflang="ko" href={koHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={koHref} />
    
    <!-- Prevent flash of unstyled content for dark mode -->
    <script is:inline>
      const theme = (() => {
        try {
          if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
            return localStorage.getItem('theme');
          }
        } catch {}
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      }
    </script>
    
    <title>{title}</title>
  </head>
  <body class="site-shell min-h-screen">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:rounded focus:bg-primary-600 focus:px-4 focus:py-2 focus:text-white">
      {lang === 'ko' ? '본문으로 건너뛰기' : 'Skip to content'}
    </a>
    <header class="site-header no-print sticky top-0 z-50 border-b">
      <nav class="site-nav mx-auto flex items-center justify-between">
        <a href={basePath} class="site-brand touch-target">
          KILPENGUIN / RESUME
        </a>
        <div class="flex items-center gap-1 sm:gap-2 md:gap-4">
          <a
            href={basePath}
            class:list={[
              'touch-target inline-flex items-center px-2 transition-colors text-sm sm:text-base',
              isResume
                ? 'font-semibold text-primary-600 dark:text-primary-400'
                : 'text-gray-600 hover:text-primary-600 dark:text-gray-300 dark:hover:text-primary-400',
            ]}
            {...(isResume ? { 'aria-current': 'page' } : {})}
          >
            {lang === 'ko' ? '이력서' : 'Resume'}
          </a>
          <a
            href={`${basePath}/portfolio`}
            class:list={[
              'touch-target inline-flex items-center px-2 transition-colors text-sm sm:text-base',
              isPortfolio
                ? 'font-semibold text-primary-600 dark:text-primary-400'
                : 'text-gray-600 hover:text-primary-600 dark:text-gray-300 dark:hover:text-primary-400',
            ]}
            {...(isPortfolio ? { 'aria-current': 'page' } : {})}
          >
            Portfolio
          </a>
          <span class="mx-1 h-4 w-px bg-gray-300 dark:bg-gray-600" aria-hidden="true"></span>
          {lang === 'ko' ? (
            <a href={enHref} class="touch-target inline-flex min-w-[44px] items-center justify-center px-3 text-xs font-medium" aria-label="Switch to English">EN</a>
          ) : (
            <a href={koHref} class="touch-target inline-flex min-w-[44px] items-center justify-center px-3 text-xs font-medium" aria-label="한국어로 전환">한</a>
          )}
          <ThemeToggle />
        </div>
      </nav>
    </header>
    
    <main id="main-content" class="site-main">
      <slot />
    </main>
    
    <footer class="no-print border-t border-gray-200 dark:border-gray-700">
      <div class="site-width py-6 text-center text-sm text-gray-500 dark:text-gray-300">
        <p>&copy; {new Date().getFullYear()} All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
