---
import Layout from '../../layouts/Layout.astro';
import { getEntry } from 'astro:content';
import { getBasePath } from '../../utils/paths';
import { prepareResumeData } from '../../utils/resume-data';

import ResumeHeader from '../resume/ResumeHeader.astro';
import ResumeSummary from '../resume/ResumeSummary.astro';
import ResumeExperience from '../resume/ResumeExperience.astro';
import ResumeCoreCompetencies from '../resume/ResumeCoreCompetencies.astro';
import ResumeSkills from '../resume/ResumeSkills.astro';
import ResumeTechnicalWriting from '../resume/ResumeTechnicalWriting.astro';
import ResumeOpenSource from '../resume/ResumeOpenSource.astro';
import ResumeLearning from '../resume/ResumeLearning.astro';
import ResumeFooterActions from '../resume/ResumeFooterActions.astro';

interface Props {
  lang: 'ko' | 'en';
}

const { lang } = Astro.props;

const entry = await getEntry(`resume-${lang}`, 'main');
if (!entry) {
  throw new Error('Resume data not found');
}
const resumeData = entry.data;

const { data, labels } = prepareResumeData(resumeData, lang);

const basePath = getBasePath(lang);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: data.name,
    jobTitle: data.title,
    email: data.email,
    url: canonicalURL.toString(),
    ...(data.location && { address: { '@type': 'PostalAddress', addressLocality: data.location } }),
    ...(data.github && { sameAs: [data.github, data.linkedin].filter(Boolean) }),
  },
};
---

<Layout title={`${data.name} — ${data.title}`} description="Professional resume and work experience" lang={lang}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="resume-container mx-auto max-w-4xl px-4 py-8">
    <!-- Header Section -->
    <ResumeHeader data={data} />

    <!-- Divider -->
    <div class="mx-auto mb-10 h-px w-24 bg-gradient-to-r from-transparent via-primary-500 to-transparent"></div>

    <!-- Summary -->
    <ResumeSummary summary={data.summary} label={labels.summary} />

    <!-- Experience -->
    <ResumeExperience experience={data.experience} labels={labels} basePath={basePath} />

    <!-- Core Competencies -->
    <ResumeCoreCompetencies coreCompetencies={data.coreCompetencies} label={labels.coreCompetencies} />

    <!-- Skills, Education, Certifications, Awards -->
    <ResumeSkills
      skills={data.skills}
      education={data.education}
      certifications={data.certifications}
      awards={data.awards}
      labels={labels}
    />

    <!-- Activities: Technical Writing + Open Source (left) | Continuous Learning (right) -->
    <div class="mb-10 grid gap-10 md:grid-cols-2">
      <!-- Left column: Technical Writing + Open Source -->
      <div>
        <ResumeTechnicalWriting technicalWriting={data.technicalWriting} label={labels.technicalWriting} />
        <ResumeOpenSource openSource={data.openSource} label={labels.openSource} />
      </div>

      <!-- Continuous Learning (right column) -->
      <div>
        <ResumeLearning continuousLearning={data.continuousLearning} label={labels.continuousLearning} />
      </div>
    </div>

    <!-- Print Buttons -->
    <ResumeFooterActions labels={labels} basePath={basePath} />
  </article>
</Layout>

