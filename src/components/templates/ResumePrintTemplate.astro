---
import { getEntry } from 'astro:content';
import { getBasePath } from '../../utils/paths';
import { prepareResumeData } from '../../utils/resume-data';
import { groupOpenSourceByRepo, parseOpenSourceName } from '../../utils/open-source';

interface Props {
  lang: 'ko' | 'en';
}

const { lang } = Astro.props;

const entry = await getEntry(`resume-${lang}`, 'main');
if (!entry) {
  throw new Error(`Resume data not found for lang: ${lang}`);
}
const resumeData = entry.data;

const { data, labels } = prepareResumeData(resumeData, lang, 'print');

const basePath = getBasePath(lang);
const pageTitle = lang === 'ko' ? '이력서' : 'Resume';
const resumeUrl = `https://kilhyeonjun.github.io/resume${lang === 'en' ? '/en' : ''}`;

const osGrouped = groupOpenSourceByRepo(data.openSource);

/** Bold key metrics: numbers with %, 배, 건, 초 units. 개 only when NOT followed by 월 (개월=months ≠ 개=items) */
function boldMetrics(text: string): string {
  return text
    .replace(/(\d+[\.]?\d*%)/g, '<strong>$1</strong>')
    .replace(/(\d+배)/g, '<strong>$1</strong>')
    .replace(/(\d+건)/g, '<strong>$1</strong>')
    .replace(/(\d+개)(?!월)/g, '<strong>$1</strong>')
    .replace(/(\d+\.?\d*초)/g, '<strong>$1</strong>');
}

/** Bold key technical terms that should stand out in 7.4s scan */
const KEY_TERMS = ['Deadlock', 'EDA', 'BigQuery', 'Lambda', 'NestJS', 'TDD', 'gRPC', 'MSA'];
function boldKeyTerms(text: string): string {
  let result = text;
  for (const term of KEY_TERMS) {
    result = result.replace(new RegExp(`(?<![<\\w])${term}(?![\\w>])`, 'g'), `<strong>${term}</strong>`);
  }
  return result;
}

/** Full text enhancement: metrics + key terms + known links */
function enhance(text: string): string {
  let result = boldKeyTerms(boldMetrics(text));
  // Known inline links
  result = result.replace('Games on AWS 2025', '<a href="https://www.youtube.com/watch?v=2jRicD15jXk">Games on AWS 2025</a>');
  result = result.replace('기술 블로그 게재', '<a href="https://jnp.tech/posts/2024-03-aws-ses-event-log">기술 블로그 게재</a>');
  result = result.replace('published tech blog', '<a href="https://jnp.tech/posts/2024-03-aws-ses-event-log">published tech blog</a>');
  return result;
}

/** Process summary: enhance (links already included) */
function processSummary(text: string): string {
  return enhance(text);
}
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{data.name} - {pageTitle}</title>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  <style>
    @page { margin: 8mm 0 6mm 0; size: A4; }

    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      font-size: 100%;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    body {
      font-family: 'Pretendard Variable', Pretendard, -apple-system, sans-serif;
      font-size: 9.5pt;
      color: #111827;
      line-height: 1.45;
      background: #fff;
      word-break: keep-all;
      overflow-wrap: break-word;
    }

    a { color: inherit; text-decoration: none; }
    a[href^="http"] { color: #1d4ed8; text-decoration: underline; text-underline-offset: 2px; }

    .resume {
      width: 210mm;
      max-width: none;
      margin: 0 auto;
      padding: 0 13mm;
    }

    /* Header */
    .header {
      text-align: center;
      margin-bottom: 2.5mm;
      padding-bottom: 2mm;
      border-bottom: 1pt solid #1d4ed8;
    }

    .name {
      font-size: 20pt;
      font-weight: 700;
      color: #111827;
      letter-spacing: -0.01em;
    }

    .title {
      font-size: 10pt;
      font-weight: 600;
      color: #1d4ed8;
      margin-top: 1mm;
    }

    .contact-info {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1mm;
      margin-top: 2mm;
      font-size: 8pt;
      line-height: 1.35;
    }
    .contact-row {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      column-gap: 1.5mm;
    }
    .contact-row-text { color: #4b5563; }
    .contact-row-links a { color: #1d4ed8; text-decoration: underline; text-underline-offset: 2px; }

    /* Section styles */
    section { margin-bottom: 2mm; }

    .section-title {
      font-size: 11pt;
      font-weight: 700;
      text-transform: none;
      letter-spacing: 0.06em;
      color: #1d4ed8;
      margin: 0 0 1.5mm;
      padding: 0 0 1mm;
      border-bottom: 0.6pt solid #e5e7eb;
    }

    /* Summary */
    .summary-text {
      font-size: 9pt;
      color: #1f2937;
      white-space: pre-line;
      line-height: 1.5;
    }

    /* Experience */
    .experience-item {
      margin-bottom: 2mm;
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .experience-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 0.5mm;
    }

    .position { font-size: 10pt; font-weight: 700; color: #111827; min-width: 0; }
    .date { font-size: 8pt; color: #6b7280; white-space: nowrap; flex-shrink: 0; }
    .company { font-size: 9pt; font-weight: 600; color: #1d4ed8; margin-bottom: 1mm; }
    .company a { color: #1d4ed8; text-decoration: underline; text-underline-offset: 2px; }
    .description { font-size: 8pt; color: #374151; margin-bottom: 1mm; }
    .project-line { font-size: 7.5pt; line-height: 1.25; margin-bottom: 0.5mm; }

    .highlights { list-style: none; padding-left: 0; margin-bottom: 1mm; }

    .highlights li {
      font-size: 9pt;
      color: #374151;
      margin-bottom: 0.3mm;
      line-height: 1.4;
    }

    .highlights li em {
      font-style: normal;
      font-weight: 600;
      color: #1f2937;
    }

    .highlight-bullet { color: #1d4ed8; margin-right: 4px; }

    /* Two-column grid */
    .two-col-grid {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      column-gap: 8mm;
      row-gap: 1mm;
      align-items: start;
    }

    /* Skills */
    .skill-group { margin-bottom: 2mm; font-size: 9pt; line-height: 1.4; break-inside: avoid; }
    .skill-category { font-weight: 700; color: #1f2937; }
    .skill-inline { color: #374151; }
    .skill-desc { display: block; font-size: 8pt; color: #6b7280; margin-top: 0.3mm; line-height: 1.35; }

    /* Education */
    .education-item { margin-bottom: 1.5mm; break-inside: avoid; }
    .institution { font-size: 9pt; font-weight: 600; color: #111827; }
    .degree { font-size: 8pt; color: #1d4ed8; }
    .edu-date { font-size: 8pt; color: #6b7280; }

    /* Certifications & Learning */
    .cert-item { margin-bottom: 1.5mm; break-inside: avoid; }
    .cert-name { font-size: 9pt; font-weight: 600; color: #111827; }
    .cert-issuer { font-size: 8pt; color: #6b7280; }


    /* Core Competencies */
    .competency-grid { display: grid; grid-template-columns: 1fr 1fr; column-gap: 6mm; row-gap: 1mm; }
    .competency-group { margin-bottom: 1mm; }
    .competency-category { font-size: 9pt; font-weight: 700; color: #111827; margin-bottom: 0.5mm; }

    /* Training Programs */
    .training-item { margin-bottom: 1.5mm; break-inside: avoid; page-break-inside: avoid; }
    .training-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.5mm; }
    .training-name { font-size: 9pt; font-weight: 600; color: #111827; }
    .training-org { font-size: 8pt; color: #1d4ed8; margin-bottom: 0.5mm; }
    .training-desc { font-size: 8pt; color: #374151; }
    .training-achievement { font-size: 8pt; color: #374151; font-style: italic; }
    /* Open Source */
    .os-repo { margin-bottom: 1mm; }
    .os-repo-name { font-size: 9pt; font-weight: 600; color: #111827; margin-bottom: 0.3mm; }
    .os-list { margin: 0; padding-left: 0; list-style: none; }
    .os-list li { font-size: 8pt; color: #374151; line-height: 1.4; margin-bottom: 0.2mm; }
    .os-date { color: #6b7280; white-space: nowrap; }

    /* Technical Writing */
    .tw-item { margin-bottom: 1mm; }
    .tw-title { font-size: 9pt; font-weight: 600; color: #111827; }
    .tw-title a { color: #1d4ed8; text-decoration: underline; text-underline-offset: 2px; }
    .tw-meta { font-size: 8pt; color: #6b7280; }
    .tw-desc { font-size: 8pt; color: #374151; margin-top: 1pt; }
    .tw-desc a { color: #1d4ed8; text-decoration: underline; text-underline-offset: 2px; }

    /* Back button (web only) */
    .back-link {
      display: block;
      text-align: center;
      padding: 16px;
      background: #f3f4f6;
      color: #1d4ed8;
      text-decoration: none;
      font-size: 14px;
    }

    .back-link:hover { background: #e5e7eb; }

    /* Korean: optimized for readability within 2 pages */
    body.lang-ko { font-size: 9.5pt; line-height: 1.4; }
    body.lang-ko .highlights li { font-size: 9pt; line-height: 1.35; }
    body.lang-ko .summary-text { font-size: 9pt; line-height: 1.45; }
    body.lang-ko .skill-group { font-size: 9pt; line-height: 1.35; }
    body.lang-ko .resume { padding: 0 12mm; }
    body.lang-ko .section-title { font-size: 11.5pt; margin: 0 0 1.5mm; }
    body.lang-ko .header { margin-bottom: 1.5mm; padding-bottom: 1mm; }
    body.lang-ko .experience-item { margin-bottom: 2.5mm; }
    body.lang-ko .competency-group { margin-bottom: 0.8mm; }
    body.lang-ko section { margin-bottom: 2mm; }
    body.lang-ko .description { font-size: 8.5pt; }

    /* English: optimized for readability within 2 pages */
    body.lang-en { font-size: 9pt; line-height: 1.35; }
    body.lang-en .highlights li { font-size: 8.5pt; line-height: 1.3; }
    body.lang-en .summary-text { font-size: 8.5pt; line-height: 1.35; }
    body.lang-en .skill-group { font-size: 8.5pt; line-height: 1.3; }
    body.lang-en .resume { padding: 0 11mm; }
    body.lang-en .section-title { font-size: 11pt; margin: 0 0 1.2mm; }
    body.lang-en .header { margin-bottom: 1.5mm; padding-bottom: 1mm; }
    body.lang-en .experience-item { margin-bottom: 2mm; }
    body.lang-en .competency-group { margin-bottom: 0.5mm; }

    @media print {
      html { font-size: 100%; }
      .back-link, .no-print { display: none !important; }
    }
  </style>
</head>
<body class={lang === 'en' ? 'lang-en' : 'lang-ko'}>
  <a href={basePath} class="back-link no-print">← {labels.backToResume}</a>
  <div class="no-print" style="position:fixed;bottom:24px;right:24px;display:flex;gap:8px;z-index:100;">
    <button onclick="window.print()" style="padding:10px 20px;background:#6b7280;color:#fff;border:none;border-radius:8px;cursor:pointer;font-size:14px;font-weight:600;box-shadow:0 2px 8px rgba(0,0,0,0.15);">
      {lang === 'ko' ? '인쇄' : 'Print'}
    </button>
    <a href={`${basePath}/pdf/resume-hr-${lang}.pdf`} download type="application/pdf" style="padding:10px 20px;background:#2563eb;color:#fff;border:none;border-radius:8px;cursor:pointer;font-size:14px;font-weight:600;box-shadow:0 2px 8px rgba(0,0,0,0.15);text-decoration:none;display:inline-block;">
      {lang === 'ko' ? '다운로드' : 'Download'}
    </a>
  </div>

  <div class="resume">
    <!-- Header -->
    <header class="header">
      <h1 class="name">{data.name}</h1>
      <p class="title">{data.title}</p>
      <div class="contact-info">
        <div class="contact-row contact-row-text">
          {data.email && <span>{data.email}</span>}
          {data.email && data.location && <span> · </span>}
          {data.location && <span>{data.location}</span>}
        </div>
        <div class="contact-row contact-row-links">
          {data.github && <><a href={data.github}>GitHub</a><span> · </span></>}
          {data.linkedin && <><a href={data.linkedin}>LinkedIn</a><span> · </span></>}
          {data.blog && <><a href={data.blog}>{lang === 'ko' ? '블로그' : 'Blog'}</a><span> · </span></>}
          <a href={resumeUrl}>{lang === 'ko' ? '이력서 웹' : 'Resume Web'}</a>
          <span> · </span>
          <a href={`${resumeUrl}/portfolio`}>{lang === 'ko' ? '포트폴리오' : 'Portfolio'}</a>
        </div>
      </div>
    </header>

    <!-- Summary -->
    {data.summary && (
      <section>
        <h2 class="section-title">{labels.summary}</h2>
        <p class="summary-text" set:html={processSummary(data.summary)} />
      </section>
    )}

    <!-- Core Competencies -->
    {data.coreCompetencies && data.coreCompetencies.length > 0 && (
      <section>
        <h2 class="section-title">{labels.coreCompetencies}</h2>
        <div class="competency-grid">
          {data.coreCompetencies.map((comp) => (
            <div class="competency-group">
              <p class="competency-category">{comp.category}</p>
              <ul class="highlights">
                {comp.items.map((item) => {
                  const parts = item.split(' — ');
                  return parts.length > 1
                    ? <li><span class="highlight-bullet">•</span><span set:html={`<b>${parts[0]}</b> — ${enhance(parts.slice(1).join(' — '))}`} /></li>
                    : <li><span class="highlight-bullet">•</span><span set:html={enhance(item)} /></li>;
                })}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Experience -->
    {data.experience && data.experience.length > 0 && (
      <section>
        <h2 class="section-title">{labels.experience}</h2>
        {data.experience.map((exp) => (
          <div class="experience-item">
            <div class="experience-header">
              <span class="position">{exp.position}</span>
              <span class="date">{exp.startDate.replace('-', '.')} — {exp.current ? labels.current : exp.endDate?.replace('-', '.')}</span>
            </div>
            <p class="company">
              {exp.company} <a href={`${resumeUrl}/experience/${exp.slug}`}>[{lang === 'ko' ? '상세' : 'Detail'}]</a>
            </p>
            {exp.description && (
              <p class="description">{exp.description}</p>
            )}
            {exp.highlights && exp.highlights.length > 0 && (
              <ul class="highlights">
                {exp.highlights.map((highlight) => (
                  <li><span class="highlight-bullet">•</span><b>{highlight.problem}</b> — {highlight.solution}, <em set:html={enhance(highlight.result)} /></li>
                ))}
              </ul>
            )}
            {exp.projects && exp.projects.length > 0 && (
              <p class="description project-line">{labels.projects}: {exp.projects.map((project) => project.name).join(', ')}</p>
            )}

          </div>
        ))}
      </section>
    )}


    <!-- Skills + Education (2-column grid) -->
    <div class="two-col-grid">
      <!-- Skills (left) -->
      {data.skills && data.skills.length > 0 && (
        <section>
          <h2 class="section-title">{labels.skills}</h2>
          {data.skills.map((skillGroup) => (
            <div class="skill-group">
              <span class="skill-category">{skillGroup.category}:</span>{' '}
              <span class="skill-inline">{skillGroup.items.map(s => s.name).join(', ')}</span>
            </div>
          ))}
        </section>
      )}

      <!-- Education + Certifications (right) -->
      <section>
        {data.education && data.education.length > 0 && (
          <div>
            <h2 class="section-title">{labels.education}</h2>
            {data.education.map((edu) => (
              <div class="education-item">
                <h3 class="institution">{edu.institution}</h3>
                <p class="degree">{edu.degree} {edu.field && `• ${edu.field}`}</p>
                <p class="edu-date">
                  {edu.startDate.replace('-', '.')} — {edu.endDate.replace('-', '.')}
                  {edu.gpa && ` | GPA: ${edu.gpa}`}
                </p>
              </div>
            ))}
          </div>
        )}
        {data.certifications && data.certifications.length > 0 && (
          <div style="margin-top:2mm;">
            <h2 class="section-title">{labels.certifications}</h2>
            {data.certifications.map((cert) => (
              <div class="cert-item">
                <h3 class="cert-name">{cert.name}</h3>
                <p class="cert-issuer">{cert.issuer} • {cert.date.replace('-', '.')}</p>
              </div>
            ))}
          </div>
        )}
      </section>
    </div>

    <!-- Activities Row 1: Technical Writing + Training Programs -->
    <div class="two-col-grid">
      {data.technicalWriting && data.technicalWriting.length > 0 && (
        <section>
          <h2 class="section-title">{labels.technicalWriting}</h2>
          {data.technicalWriting.map((item) => {
            const primaryUrl = item.url || item.videoUrl || item.reviewUrl;
            return (
              <div class="tw-item">
                <h3 class="tw-title">
                  {primaryUrl
                    ? <a href={primaryUrl}>{item.title}</a>
                    : item.title}
                  {item.videoUrl && item.url && <>{' '}<a href={item.videoUrl}>[{lang === 'ko' ? '영상' : 'Video'}]</a></>}
                  {item.reviewUrl && (item.url || item.videoUrl) && <>{' '}<a href={item.reviewUrl}>[{lang === 'ko' ? '후기' : 'Review'}]</a></>}
                </h3>
                <p class="tw-meta">{item.type} — {item.date.replace('-', '.')}</p>
                {item.description && (
                  <h3 class="tw-title">
                    {primaryUrl
                      ? <a href={primaryUrl}>{item.description}</a>
                      : item.description}
                  </h3>
                )}
              </div>
            );
          })}
        </section>
      )}
      {data.trainingPrograms && data.trainingPrograms.length > 0 && (
        <section>
          <h2 class="section-title">{labels.trainingPrograms}</h2>
          {data.trainingPrograms.map((program) => (
            <div class="training-item">
              <div class="training-header">
                <span class="training-name">{program.name}{program.url && <>{' '}<a href={program.url}>[GitHub]</a></>}</span>
                <span class="date">{program.period}</span>
              </div>
              <p class="training-org">{program.organization}{program.reviewUrl && <>{' · '}<a href={program.reviewUrl}>[{lang === 'ko' ? '후기' : 'Review'}]</a></>}</p>
              {program.description && <p class="training-desc">{program.description}</p>}
              {program.achievement && <p class="training-achievement">{program.achievement}</p>}
            </div>
          ))}
        </section>
      )}
    </div>

    <!-- Activities Row 2: Open Source + Continuous Learning -->
    <div class="two-col-grid">
      {data.openSource && data.openSource.length > 0 && (
        <section>
          <h2 class="section-title">{labels.openSource}</h2>
          {Object.entries(osGrouped).map(([repo, { repoUrl, items }]) => (
            <div class="os-repo">
              <h3 class="os-repo-name">{repo}{repoUrl && <>{' '}<a href={repoUrl}>[GitHub]</a></>}</h3>
              <ul class="os-list">
                {items.map((item) => {
                  const { description: desc } = parseOpenSourceName(item.name);
                  const prMatch = item.url?.match(/\/(pull|issues)\/(\d+)/);
                  const linkLabel = prMatch ? `#${prMatch[2]}` : '[PR]';
                  return (
                    <li>
                      <span class="highlight-bullet">•</span>
                      {desc}{item.url && <>{' '}<a href={item.url}>{linkLabel}</a></>}<span class="os-date"> — {item.date}</span>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
        </section>
      )}
      {data.continuousLearning && data.continuousLearning.length > 0 && (
        <section>
          <h2 class="section-title">{labels.continuousLearning}</h2>
          {data.continuousLearning.map((item) => (
            <div class="cert-item">
              <h3 class="cert-name">{item.name}{item.url && <>{' '}<a href={item.url}>{item.url.includes('github.com') ? '[GitHub]' : '[' + (lang === 'ko' ? '링크' : 'Link') + ']'}</a></>} — {item.description}</h3>
              <p class="cert-issuer">{item.period}</p>
            </div>
          ))}
        </section>
      )}
    </div>
</body>
</html>
