---
import { getEntry } from 'astro:content';
import { getBasePath, withBasePath } from '../../utils/paths';
import { prepareResumeData } from '../../utils/resume-data';

interface Props {
  lang: 'ko' | 'en';
}

const { lang } = Astro.props;

const entry = await getEntry(`resume-${lang}`, 'main');
if (!entry) {
  throw new Error('Resume data not found');
}
const resumeData = entry.data;

const { data, labels } = prepareResumeData(resumeData, lang, 'ats');

const basePath = getBasePath(lang);
const pageTitle = lang === 'ko' ? `${data.name} - 이력서 (ATS 최적화)` : `${data.name} - Resume (ATS Optimized)`;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <link rel="icon" type="image/svg+xml" href={withBasePath('favicon.svg')}>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{pageTitle}</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      font-size: 8.5pt;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      color: #000;
      background: #fff;
      line-height: 1.25;
      max-width: 210mm;
      margin: 0 auto;
      padding: 8mm;
    }

    header {
      margin-bottom: 12px;
      border-bottom: 2px solid #000;
      padding-bottom: 8px;
    }

    h1 {
      font-size: 18pt;
      font-weight: bold;
      margin-bottom: 4px;
    }

    .title {
      font-size: 11pt;
      font-weight: normal;
      color: #333;
      margin-bottom: 6px;
    }

    .contact {
      font-size: 9pt;
    }

    .contact-item {
      margin-right: 16px;
    }

    section {
      margin-bottom: 6px;
    }

    h2 {
      font-size: 11pt;
      font-weight: bold;
      text-transform: uppercase;
      border-bottom: 1px solid #000;
      padding-bottom: 4px;
      margin-bottom: 4px;
    }

    h3 {
      font-size: 10pt;
      font-weight: bold;
      margin-bottom: 2px;
    }

    p {
      font-size: 9pt;
      margin-bottom: 4px;
    }

    .item {
      margin-bottom: 6px;
      page-break-inside: avoid;
      break-inside: avoid;
    }

    .item-header {
      margin-bottom: 4px;
    }

    .company,
    .institution {
      font-weight: bold;
    }

    .date {
      font-style: italic;
    }

    .position,
    .degree {
      font-weight: normal;
    }

    ul {
      margin-left: 20px;
      margin-bottom: 6px;
    }

    li {
      font-size: 9pt;
      margin-bottom: 4px;
    }

    .skills-list {
      font-size: 9pt;
    }

    .skill-category {
      font-weight: bold;
    }

    a {
      color: #000;
      text-decoration: underline;
      text-underline-offset: 1px;
    }

    body[data-lang='en'] {
      font-size: 8pt;
      line-height: 1.2;
      padding: 6mm;
    }
    body[data-lang='en'] li {
      font-size: 8pt;
      margin-bottom: 2px;
    }

    @media print {
      body {
        padding: 0;
      }

      .no-print {
        display: none !important;
      }
    }

    @page {
      margin: 8mm;
      size: A4;
    }

    .competency-group {
      margin-bottom: 12px;
    }

    .back-link {
      display: block;
      text-align: center;
      padding: 12px;
      background: #f0f0f0;
      margin-bottom: 20px;
      text-decoration: underline;
    }

  </style>
</head>
<body data-lang={lang}>
<main>
  <a href={basePath} class="back-link no-print">&larr; {labels.backToResume}</a>

  <header>
    <h1>{data.name}</h1>
    <p class="title">{data.title}</p>
    <p class="contact">
      {data.email && <span class="contact-item">{data.email}</span>}
      {data.location && <span class="contact-item">{data.location}</span>}
    </p>
    {(data.github || data.linkedin || data.blog) && (
      <p class="contact">
        {data.github && <a href={data.github} class="contact-item">{data.github.replace('https://', '')}</a>}
        {data.linkedin && <a href={data.linkedin} class="contact-item">{data.linkedin.replace('https://', '')}</a>}
        {data.blog && <a href={data.blog} class="contact-item">{lang === 'ko' ? '블로그' : 'Blog'}: {data.blog.replace('https://', '')}</a>}
      </p>
    )}
  </header>

  {data.summary && (
    <section>
      <h2>{labels.summary.toUpperCase()}</h2>
      <p set:html={data.summary.replace('Games on AWS 2025', '<a href="https://www.youtube.com/watch?v=2jRicD15jXk">Games on AWS 2025</a>')} />
    </section>
  )}

  {data.coreCompetencies && data.coreCompetencies.length > 0 && (
    <section>
      <h2>{labels.coreCompetencies.toUpperCase()}</h2>
      {data.coreCompetencies.map((comp) => (
        <div class="competency-group">
          <p><strong>{comp.category}</strong></p>
          <ul>
            {comp.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  )}

  {data.experience && data.experience.length > 0 && (
    <section>
      <h2>{labels.experience.toUpperCase()}</h2>
      {data.experience.map((exp) => (
        <div class="item">
          <div class="item-header">
            <h3>
              <span class="company">{exp.company}</span> — <span class="position">{exp.positions ? exp.positions[0].title : exp.position}</span>
            </h3>
            <p class="date">{exp.startDate.replace('-', '.')} - {exp.current ? labels.current : exp.endDate?.replace('-', '.')}</p>
          </div>
          {exp.description && <p>{exp.description}</p>}
          {exp.positions && exp.positions.length > 1 && exp.positions.map((pos) => (
            <div>
              <p><strong>{pos.title}</strong> ({pos.startDate.replace('-', '.')} - {pos.current ? labels.current : pos.endDate?.replace('-', '.')})</p>
              {pos.highlights && pos.highlights.length > 0 && (
                <ul>
                  {pos.highlights.map((highlight) => (
                    <li>{highlight.problem}. {highlight.solution}. {highlight.result}.</li>
                  ))}
                </ul>
              )}
            </div>
          ))}
          {!exp.positions && exp.highlights && exp.highlights.length > 0 && (
            <ul>
              {exp.highlights.map((highlight) => (
                <li>{highlight.problem}. {highlight.solution}. {highlight.result}.</li>
              ))}
            </ul>
          )}
          {exp.projects && exp.projects.length > 0 && (
            <p><strong>{labels.projects.toUpperCase()}</strong>: {exp.projects.map((project) => project.name).join(', ')}</p>
          )}
        </div>
      ))}
    </section>
  )}

  {data.skills && data.skills.length > 0 && (
    <section>
      <h2>{labels.skills.toUpperCase()}</h2>
      {data.skills.map((skillGroup) => (
        <p class="skills-list">
          <span class="skill-category">{skillGroup.category}:</span>{' '}
          {skillGroup.items.map(s => s.name).join(', ')}
          {skillGroup.description && ` — ${skillGroup.description}`}
        </p>
      ))}
    </section>
  )}

  {data.education && data.education.length > 0 && (
    <section>
      <h2>{labels.education.toUpperCase()}</h2>
      {data.education.map((edu) => (
        <div class="item">
          <h3>
            <span class="institution">{edu.institution}</span>
          </h3>
          <p>
            <span class="degree">{edu.degree}</span>
            {edu.field && <span>, {edu.field}</span>}
          </p>
          <p class="date">
            {edu.startDate.replace('-', '.')} - {edu.endDate.replace('-', '.')}
            {edu.gpa && <span> | GPA: {edu.gpa}</span>}
          </p>
        </div>
      ))}
    </section>
  )}

  {data.certifications && data.certifications.length > 0 && (
    <section>
      <h2>{labels.certifications.toUpperCase()}</h2>
      {data.certifications.map((cert) => (
        <p>
          <strong>{cert.name}</strong> — {cert.issuer}, {cert.date.replace('-', '.')}
        </p>
      ))}
    </section>
  )}

  {data.awards && data.awards.length > 0 && (
    <section>
      <h2>{labels.awards.toUpperCase()}</h2>
      {data.awards.map((award) => (
        <p>
          <strong>{award.name}</strong>{award.description && ` — ${award.description}`}, {award.date.replace('-', '.')}
        </p>
      ))}
    </section>
  )}

  {data.technicalWriting && data.technicalWriting.length > 0 && (
    <section>
      <h2>{labels.technicalWriting.toUpperCase()}</h2>
      {data.technicalWriting.map((item) => (
        <div class="item">
          <h3>{item.title}</h3>
          <p class="date">{item.type} — {item.date.replace('-', '.')}</p>
          {item.description && <p>{item.description}</p>}
        </div>
      ))}
    </section>
  )}
  {data.trainingPrograms && data.trainingPrograms.length > 0 && (
    <section>
      <h2>{labels.trainingPrograms.toUpperCase()}</h2>
      {data.trainingPrograms.map((program) => (
        <div class="item">
          <div class="item-header">
            <h3>{program.name}</h3>
            <p class="date">{program.period}</p>
          </div>
          <p><span class="institution">{program.organization}</span></p>
          {program.description && <p>{program.description}</p>}
          {program.achievement && <p>{program.achievement}</p>}
        </div>
      ))}
    </section>
  )}
  {data.openSource && data.openSource.length > 0 && (
    <section>
      <h2>{labels.openSource.toUpperCase()}</h2>
      {data.openSource.map((item) => (
        <div class="item">
          <h3>{item.url ? <a href={item.url}>{item.name}</a> : item.name}</h3>
          <p class="date">{item.date.replace('-', '.')}</p>
        </div>
      ))}
    </section>
  )}
  {data.continuousLearning && data.continuousLearning.length > 0 && (
    <section>
      <h2>{labels.continuousLearning.toUpperCase()}</h2>
      {data.continuousLearning.map((item) => (
        <div class="item">
          <h3>{item.name}</h3>
          <p class="date">{item.period}</p>
          {item.description && <p>{item.description}</p>}
        </div>
      ))}
    </section>
  )}

  <div class="no-print" style="position:fixed;bottom:20px;right:20px;display:flex;gap:8px;z-index:100;">
    <button onclick="window.print()" style="padding:12px 24px;background:#6b7280;color:white;border:none;border-radius:8px;cursor:pointer;font-size:14px;font-weight:500;box-shadow:0 2px 8px rgba(0,0,0,0.15);">
      {lang === 'ko' ? '인쇄' : 'Print'}
    </button>
    <a href={withBasePath(`pdf/resume-ats-${lang}.pdf`)} download type="application/pdf" style="padding:12px 24px;background:#2563eb;color:white;border:none;border-radius:8px;cursor:pointer;font-size:14px;font-weight:500;box-shadow:0 2px 8px rgba(0,0,0,0.15);text-decoration:none;display:inline-block;">
      {lang === 'ko' ? '다운로드' : 'Download'}
    </a>
  </div>
</main>
</body>
</html>
