---
import { getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getLocalePrefix, withBasePath } from '../../utils/paths';
import { prepareResumeData } from '../../utils/resume-data';
import { getCareerDuration } from '../../utils/career-duration';
import rawPortfolioData from '../../data/portfolio.json';
import { portfolioDataSchema } from '../../types/portfolio';
import { selectPublicPortfolioProjects } from '../../utils/portfolio-visibility';

import ResumeHeader from '../resume/ResumeHeader.astro';
import ResumeSummary from '../resume/ResumeSummary.astro';
import ResumeExperience from '../resume/ResumeExperience.astro';
import ResumeCoreCompetencies from '../resume/ResumeCoreCompetencies.astro';
import ResumeSkills from '../resume/ResumeSkills.astro';
import ResumeTechnicalWriting from '../resume/ResumeTechnicalWriting.astro';
import ResumeOpenSource from '../resume/ResumeOpenSource.astro';
import ResumeLearning from '../resume/ResumeLearning.astro';
import ResumeTrainingPrograms from '../resume/ResumeTrainingPrograms.astro';


interface Props {
  lang: 'ko' | 'en';
}

const { lang } = Astro.props;

const entry = await getEntry(`resume-${lang}`, 'main');
if (!entry) {
  throw new Error(`Resume data not found for lang: ${lang}`);
}
const resumeData = entry.data;

const { data, labels } = prepareResumeData(resumeData, lang, 'web');
const [introduction, ...background] = data.summary.split(/\n\s*\n/);

const localePrefix = getLocalePrefix(lang);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: data.name,
    jobTitle: data.title,
    email: data.email,
    url: canonicalURL.toString(),
    ...(data.location && { address: { '@type': 'PostalAddress', addressLocality: data.location } }),
    ...(data.github && { sameAs: [data.github, data.linkedin].filter(Boolean) }),
  },
};
const portfolioData = portfolioDataSchema.parse(rawPortfolioData);
const publicProjects = selectPublicPortfolioProjects(portfolioData.projects);
const outcomeProofs = data.experience
  .flatMap((exp) => exp.positions?.flatMap((position) => position.highlights ?? []) ?? exp.highlights ?? [])
  .filter((proof) => proof.proofLabel)
  .map((proof) => {
    const project = publicProjects.find((project) => project.slug === proof.evidenceProject);
    if (!project) {
      throw new Error(`Invalid Evidence Board target for ${lang}: "${proof.evidenceProject ?? '(missing)'}" must reference a public portfolio case`);
    }
    return { ...proof, project };
  });
---

<Layout title={`${data.name} — ${data.title}`} description={lang === 'ko' ? `${data.name} — 라이브 게임 공통 백엔드 플랫폼을 설계·운영하는 Backend Engineer / Platform Part Leader. 실시간 채팅, 데이터 파이프라인, 공통 패키지의 성과와 검증 조건을 확인하세요.` : `${data.name} — Backend Engineer / Platform Part Leader designing and operating shared backend platforms for live games. Explore real-time chat, data pipelines, shared packages, and qualified engineering results.`} lang={lang}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="resume-dossier resume-container">
    <!-- Header Section -->
    <ResumeHeader data={data} careerLabel={`${getCareerDuration(resumeData.experience, lang)} ${lang === 'ko' ? '경력' : 'experience'}`}>
      <ResumeSummary summary={introduction} label={labels.summary} lead />
    </ResumeHeader>

    <nav class="resume-actions no-print flex gap-3 text-sm" aria-label={lang === 'ko' ? '채용 검토 자료' : 'Hiring materials'}>
      <a href={withBasePath(`pdf/resume-hr-${lang}.pdf`)} download type="application/pdf" class="primary touch-target">{lang === 'ko' ? '이력서 PDF 다운로드' : 'Download resume PDF'}</a>
      <a href={`${localePrefix}/portfolio`} class="touch-target">{lang === 'ko' ? '대표 사례 보기' : 'Explore case studies'}</a>
    </nav>

    <aside class="outcome-board" aria-labelledby="evidence-board-heading">
      <h2 id="evidence-board-heading" class="dossier-label board-heading">EVIDENCE BOARD</h2>
      {outcomeProofs.map((proof) => {
        const kicker = proof.proofLabel ?? '';
        // Thousands separators and decimals like "6,000" or "$1.1," are not clause breaks.
        const [metricText, ...tailParts] = proof.result.split(/(?<!\d),\s*/);
        const metric = metricText.startsWith(kicker)
          ? metricText.slice(kicker.length).trim()
          : metricText;
        const tail = tailParts.join(', ');
        return (
          <section class="outcome-row">
            <p class="outcome-result">
              <span class="result-kicker">{kicker}</span>
              <strong class="result-metric">{metric}</strong>
              {tail && <span class="result-tail">{tail}</span>}
            </p>
            <div class="outcome-copy">
              <p class="outcome-problem">{proof.problem}</p>
              <a href={`${localePrefix}/portfolio/${proof.project.slug}`} class="outcome-case-link touch-target" aria-label={`${lang === 'ko' ? '근거 사례 보기' : 'View case study'}: ${proof.project.name[lang]}`}>
                {lang === 'ko' ? '근거 사례 보기' : 'View case study'}
              </a>
            </div>
          </section>
        );
      })}
    </aside>

    <!-- Divider -->
    <div class="resume-divider" aria-hidden="true"></div>

    <details class="resume-documents no-print">
      <summary>{lang === 'ko' ? '다른 형식의 채용 자료 · PDF 미리보기 / ATS / 경력기술서' : 'Other hiring formats · PDF previews / ATS / career detail'}</summary>
      <nav aria-label={lang === 'ko' ? '문서 형식 선택' : 'Document formats'}>
        <a href={`${localePrefix}/resume-print`}>{lang === 'ko' ? '이력서 PDF 미리보기' : 'Resume PDF preview'}</a>
        <a href={`${localePrefix}/resume-ats`}>{labels.atsOptimized}</a>
        <a href={`${localePrefix}/experience-print`}>{lang === 'ko' ? '경력기술서' : 'Career detail'}</a>
        <a href={`${localePrefix}/portfolio-print`}>{lang === 'ko' ? '포트폴리오 PDF 미리보기' : 'Portfolio PDF preview'}</a>
      </nav>
    </details>

    <!-- Experience precedes the supporting competency inventory. -->
    <ResumeExperience experience={data.experience} labels={labels} basePath={localePrefix} />

    <ResumeSummary summary={background.join('\n\n')} label={labels.summary} />
    <ResumeCoreCompetencies coreCompetencies={data.coreCompetencies} label={labels.coreCompetencies} />
    <ResumeExperience experience={data.sideProjects} labels={labels} basePath={localePrefix} title={labels.sideProjects} />

    <!-- Social Proof: Technical Writing + Open Source (after experience for visibility) -->
    <div class="mb-10 grid gap-10 md:grid-cols-2">
      <ResumeTechnicalWriting technicalWriting={data.technicalWriting} label={labels.technicalWriting} />
      <ResumeOpenSource openSource={data.openSource} label={labels.openSource} />
    </div>

    <!-- Skills, Education, Certifications, Awards -->
    <ResumeSkills
      skills={data.skills}
      education={data.education}
      certifications={data.certifications}
      labels={labels}
    />

    <!-- Activities: Training + Learning -->
    <div class="mb-10 grid gap-10 md:grid-cols-2">
      <ResumeTrainingPrograms trainingPrograms={data.trainingPrograms} label={labels.trainingPrograms} />
      <ResumeLearning continuousLearning={data.continuousLearning} label={labels.continuousLearning} />
    </div>

    <!-- Print Buttons -->
  </article>
</Layout>
