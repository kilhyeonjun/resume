    { "id": "ack", "from": "gateway", "to": "client", "y": 230, "label": "ACK ≠ durable storage", "variant": "return" },
    { "id": "append", "from": "gateway", "to": "wal", "y": 260, "label": "Async WAL recording", "variant": "dashed" },
    { "id": "read", "from": "writer", "to": "wal", "y": 335, "label": "XREADGROUP · read entries" },
    { "id": "persist", "from": "writer", "to": "db", "y": 365, "label": "Batch-write segments" },
    { "id": "xack", "from": "writer", "to": "wal", "y": 395, "label": "XACK successfully stored items", "variant": "return" },
