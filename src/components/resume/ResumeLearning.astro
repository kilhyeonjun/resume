---
import ExternalLinkIcon from '../icons/ExternalLinkIcon.astro';
import YouTubeIcon from '../icons/YouTubeIcon.astro';
import GitHubIcon from '../icons/GitHubIcon.astro';
import type { ContinuousLearning } from '../../content.config';

interface Props {
  continuousLearning: ContinuousLearning[];
  label: string;
}

const { continuousLearning, label } = Astro.props;
---

{continuousLearning && continuousLearning.length > 0 && (
  <section>
    <h2 class="section-title">{label}</h2>
    <div class="mt-6 space-y-4">
      {continuousLearning.map((item) => (
        <div class="flex items-start gap-3">
          <div class="flex-1">
            <h3 class="font-semibold text-gray-900 dark:text-white flex items-center gap-1.5">
              {item.name}
              {item.url && (
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex text-gray-500 hover:text-primary-600 dark:text-gray-300 dark:hover:text-primary-400"
                  aria-label={item.name + ' 링크'}
                >
                  {item.url.includes('youtube.com') || item.url.includes('youtu.be') ? (
                    <YouTubeIcon class="h-4 w-4" />
                  ) : item.url.includes('github.com') ? (
                    <GitHubIcon class="h-4 w-4" />
                  ) : (
                    <ExternalLinkIcon class="h-4 w-4" />
                  )}
                </a>
              )}
            </h3>
            <p class="text-sm text-gray-600 dark:text-gray-300">
              {item.period} — {item.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </section>
)}
