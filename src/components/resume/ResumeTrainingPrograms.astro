---
import ExternalLinkIcon from '../icons/ExternalLinkIcon.astro';
import GitHubIcon from '../icons/GitHubIcon.astro';
import BlogIcon from '../icons/BlogIcon.astro';
import type { TrainingProgram } from '../../content.config';

interface Props {
  trainingPrograms: TrainingProgram[];
  label: string;
}

const { trainingPrograms, label } = Astro.props;
---

{trainingPrograms && trainingPrograms.length > 0 && (
  <section>
    <h2 class="section-title">{label}</h2>
    <div class="mt-6 space-y-4">
      {trainingPrograms.map((item) => (
        <div class="flex items-start gap-3">
          <div class="flex-1">
            <h3 class="font-semibold text-gray-900 dark:text-white flex items-center gap-1.5">
              {item.name}
              {item.url && (
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center text-gray-500 hover:text-primary-600 dark:text-gray-300 dark:hover:text-primary-400"
                  aria-label={item.name + ' 링크'}
                >
                  {item.url.includes('github.com') ? (
                    <GitHubIcon class="h-4 w-4" />
                  ) : (
                    <ExternalLinkIcon class="h-4 w-4" />
                  )}
                </a>
              )}
              {item.reviewUrl && (
                <a
                  href={item.reviewUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center text-gray-500 hover:text-primary-600 dark:text-gray-300 dark:hover:text-primary-400"
                  aria-label={item.name + ' 후기'}
                >
                  {item.reviewUrl.includes('tistory') || item.reviewUrl.includes('blog') || item.reviewUrl.includes('github.io') ? (
                    <BlogIcon class="h-4 w-4" />
                  ) : (
                    <ExternalLinkIcon class="h-4 w-4" />
                  )}
                </a>
              )}
            </h3>
            <p class="text-sm text-gray-600 dark:text-gray-300">
              {item.period}
              {item.organization && <span> · {item.organization}</span>}
              {' — '}{item.description}
            </p>
            {item.achievement && (
              <p class="mt-0.5 text-sm text-gray-500 dark:text-gray-300">{item.achievement}</p>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>
)}