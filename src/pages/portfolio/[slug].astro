---
import PortfolioDetailTemplate from '../../components/templates/PortfolioDetailTemplate.astro';
import rawPortfolioData from '../../data/portfolio.json';
import { portfolioDataSchema } from '../../types/portfolio';
import { selectPublicPortfolioProjects } from '../../utils/portfolio-visibility';

export function getStaticPaths() {
  const portfolioData = portfolioDataSchema.parse(rawPortfolioData);
  const { projects: rawProjects, labels } = portfolioData;
  const projects = selectPublicPortfolioProjects(rawProjects);
  
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: { 
      project, 
      index,
      total: projects.length,
      allProjects: projects,
      labels: labels.ko
    }
  }));
}

const props = Astro.props;
---
<PortfolioDetailTemplate lang="ko" {...props} />
