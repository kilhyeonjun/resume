%%{init: {"flowchart": {"htmlLabels": false, "curve": "linear"}, "themeVariables": {"fontSize": "24px"}}}%%
flowchart LR
  U[User] --> C[Canonicalize path] --> R[One owning boundary] --> H[Isolated runtime] --> G[Verify configuration] --> A[Start CLI]
  C -->|path escape| X[Abort before launch]
  R -->|none or tie| X
  G -->|failure| X

  classDef primary fill:#eff6ff,stroke:#2563eb,color:#0f172a,stroke-width:2px;
  classDef boundary fill:#f8fafc,stroke:#64748b,color:#0f172a,stroke-width:2px;
  classDef pass fill:#f0fdf4,stroke:#16a34a,color:#0f172a,stroke-width:2px;
  classDef fail fill:#fff1f2,stroke:#e11d48,color:#0f172a,stroke-width:2px;
  class U,C primary;
  class R,H boundary;
  class G,A pass;
  class X fail;
