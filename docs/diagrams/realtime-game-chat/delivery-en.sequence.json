    { "id": "retry", "from": "writer", "to": "db", "y": 500, "label": "Bounded retries", "variant": "dashed" },
    { "id": "pending", "from": "writer", "to": "wal", "y": 530, "label": "Keep unfinished entries pending", "variant": "dashed" }
